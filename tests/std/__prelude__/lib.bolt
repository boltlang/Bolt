// Floats have no `Ord`: NaN is neither less than, equal to nor greater
// than any float, so comparing with it gives `None`.

/// The ordering of two floats, or `None` when one of them is NaN.
fn float_ordering(lt: Bool, gt: Bool, eq: Bool) -> Option[Ordering] =
  if lt || gt || eq { Some(ordering(lt, gt)) } else { None };

impl PartialOrd[f32] {
  fn partial_cmp(a, b) = float_ordering(f32_lt(a, b), f32_gt(a, b), f32_eq(a, b));
  fn lt(a, b) = f32_lt(a, b);
  fn gt(a, b) = f32_gt(a, b);
  fn lte(a, b) = f32_le(a, b);
  fn gte(a, b) = f32_ge(a, b);
}
impl PartialOrd[f64] {
  fn partial_cmp(a, b) = float_ordering(f64_lt(a, b), f64_gt(a, b), f64_eq(a, b));
  fn lt(a, b) = f64_lt(a, b);
  fn gt(a, b) = f64_gt(a, b);
  fn lte(a, b) = f64_le(a, b);
  fn gte(a, b) = f64_ge(a, b);
}

pub fn a < b = lt(a, b);

pub fn a > b = gt(a, b);

pub fn a <= b = lte(a, b);

pub fn a >= b = gte(a, b);

// Tuples are compared element by element, from the first. A tuple has
// `Eq`, `PartialOrd` or `Ord` when each of its elements does.

impl Eq[()] { fn eq(a, b) = True; }
impl PartialOrd[()] { fn partial_cmp(a, b) = Some(Ordering.Equal); }
impl Ord[()] { fn cmp(a, b) = Ordering.Equal; }

impl[A, B] Eq[(A, B)] where Eq[A], Eq[B] {
  fn eq(a, b) = a.0 == b.0 && a.1 == b.1;
}

impl[A, B] PartialOrd[(A, B)] where PartialOrd[A], PartialOrd[B] {
  fn partial_cmp(a, b) = match partial_cmp(a.0, b.0) { Some(Ordering.Equal) => partial_cmp(a.1, b.1), other => other };
}

impl[A, B] Ord[(A, B)] where Ord[A], Ord[B] {
  fn cmp(a, b) = match cmp(a.0, b.0) { Ordering.Equal => cmp(a.1, b.1), other => other };
}

impl[A, B, C] Eq[(A, B, C)] where Eq[A], Eq[B], Eq[C] {
  fn eq(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2;
}

impl[A, B, C] PartialOrd[(A, B, C)] where PartialOrd[A], PartialOrd[B], PartialOrd[C] {
  fn partial_cmp(a, b) = match partial_cmp(a.0, b.0) { Some(Ordering.Equal) => match partial_cmp(a.1, b.1) { Some(Ordering.Equal) => partial_cmp(a.2, b.2), other => other }, other => other };
}

impl[A, B, C] Ord[(A, B, C)] where Ord[A], Ord[B], Ord[C] {
  fn cmp(a, b) = match cmp(a.0, b.0) { Ordering.Equal => match cmp(a.1, b.1) { Ordering.Equal => cmp(a.2, b.2), other => other }, other => other };
}

impl[A, B, C, D] Eq[(A, B, C, D)] where Eq[A], Eq[B], Eq[C], Eq[D] {
  fn eq(a, b) = a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3;
}

impl[A, B, C, D] PartialOrd[(A, B, C, D)] where PartialOrd[A], PartialOrd[B], PartialOrd[C], PartialOrd[D] {
  fn partial_cmp(a, b) = match partial_cmp(a.0, b.0) { Some(Ordering.Equal) => match partial_cmp(a.1, b.1) { Some(Ordering.Equal) => match partial_cmp(a.2, b.2) { Some(Ordering.Equal) => partial_cmp(a.3, b.3), other => other }, other => other }, other => other };
}

impl[A, B, C, D] Ord[(A, B, C, D)] where Ord[A], Ord[B], Ord[C], Ord[D] {
  fn cmp(a, b) = match cmp(a.0, b.0) { Ordering.Equal => match cmp(a.1, b.1) { Ordering.Equal => match cmp(a.2, b.2) { Ordering.Equal => cmp(a.3, b.3), other => other }, other => other }, other => other };
}

// The classes of operators, like Rust's `std::ops`. Each operator is a
// function of its class's method, so that it works on any type with an
// impl of the class. The primitive types have theirs, which are the
// builtins of `prim.bolt`.

/// Addition: `a + b`.
pub class Add[T] {
  /// The type of the result.
  type Output = T;

  fn add(a: T, b: T) -> Output;
}

impl Add[i8] { fn add(a, b) = i8_add(a, b); }
impl Add[i16] { fn add(a, b) = i16_add(a, b); }
impl Add[i32] { fn add(a, b) = i32_add(a, b); }
impl Add[i64] { fn add(a, b) = i64_add(a, b); }
impl Add[i128] { fn add(a, b) = i128_add(a, b); }
impl Add[isize] { fn add(a, b) = isize_add(a, b); }
impl Add[u8] { fn add(a, b) = u8_add(a, b); }
impl Add[u16] { fn add(a, b) = u16_add(a, b); }
impl Add[u32] { fn add(a, b) = u32_add(a, b); }
impl Add[u64] { fn add(a, b) = u64_add(a, b); }
impl Add[u128] { fn add(a, b) = u128_add(a, b); }
impl Add[usize] { fn add(a, b) = usize_add(a, b); }
impl Add[f32] { fn add(a, b) = f32_add(a, b); }
impl Add[f64] { fn add(a, b) = f64_add(a, b); }

pub fn a + b = add(a, b);

