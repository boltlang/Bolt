  fn partial_cmp(a, b) = Some(cmp(a, b));
  fn lt(a, b) = i16_lt(a, b);
  fn gt(a, b) = i16_gt(a, b);
  fn lte(a, b) = i16_le(a, b);
  fn gte(a, b) = i16_ge(a, b);
}
