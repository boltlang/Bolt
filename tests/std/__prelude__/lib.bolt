// A small prelude for the tests in `tests/`, which a case gets with the
// attribute `:test-prelude`: the classes that syntax uses, `xs[i]`,
// `xs[i] = x`, `for x in xs` and `a == b`, with their impls for arrays,
// `String` and `Char`, the types of string and character literals, `Debug`,
// which the evaluator shows characters with, and a few functions the
// compiler provides. It's a copy of what `packages/std` has
// of them, so that a case that only needs these doesn't change when `std`
// does.

extern "bolt" {

  /// Write `text` and a newline.
  pub fn print(text: String);

  /// Stop the program with an error, with `message`.
  pub fn panic(message: String) -> !;

  /// The number of elements of `xs`.
  pub fn array_len[T](xs: [T]) -> i32;

  pub(package) fn array_get[T](xs: [T], i: i32) -> T;

  pub(package) fn array_set[T](xs: mut [T], i: i32, x: T);

}

/// Text, as its bytes in UTF-8, like `std`'s `String`: the type of string
/// literals, and what `print` and `panic` take.
pub imm struct String([u8]);

/// Types whose values can be compared, with `a == b` and `a != b`.
pub class Eq[T] {
  fn eq(a: T, b: T) -> Bool;
  fn ne(a: T, b: T) -> Bool = !eq(a, b);
}

pub fn a == b = eq(a, b);

pub fn a != b = ne(a, b);

impl Eq[String] {
  fn eq(a, b) {
    if array_len(a.0) != array_len(b.0) {
      return False;
    }
    let mut i = 0;
    while i < array_len(a.0) {
      if array_get(a.0, i) != array_get(b.0, i) {
        return False;
      }
      i += 1;
    }
    True
  }
}

/// A character, like `std`'s `Char`: the type of character literals, which
/// holds its code point.
pub imm struct Char(u32);

impl Eq[Char] {
  fn eq(a, b) = a.0 == b.0;
}

/// How values look in code, like `std`'s `Debug`, but giving a `String`.
/// The evaluator shows values of types with an impl with `debug_string`.
pub class Debug[T] {
  fn debug(x: T) -> String;
}

pub fn debug_string[T](x: T) -> String where Debug[T] = debug(x);

/// Characters look like `'a'`. Only ASCII ones without escapes, which is
/// what the tests show.
impl Debug[Char] {
  fn debug(c) = String([39, c.0 as u8, 39]);
}

pub enum Option[T] {
  None,
  Some(T),
}

pub import Option.*;

/// Types whose elements can be read by position, with `c[i]`.
pub class Index[C] {
  type Item;
  fn index(c: C, i: i32) -> Item;
}

/// Types whose elements can be replaced by position, with `c[i] = x`.
pub class IndexMut[C] where Index[C] {
  fn set_index(c: C, i: i32, x: C.Item);
}

/// Types that give their items one at a time, until there are none left.
pub class Iterator[I] {
  type Item;
  fn next(it: I) -> Option[Item];
}

/// Types that can be looped over with `for x in c`.
pub class Iterable[C] {
  type Iter: Iterator;
  fn iter(c: C) -> Iter;
}

/// An iterator made from a function that gives the next item each time
/// it's called.
pub struct FnIter[T] {
  next: fn() -> Option[T],
}

impl[T] Iterator[FnIter[T]] {
  type Item = T;
  fn next(it) = (it.next)();
}

impl[T] Iterable['m FnIter[T]] {
  type Iter = 'm FnIter[T];
  fn iter(it) = it;
}

impl[T] Index[[T]] {
  type Item = T;
  fn index(xs, i) = array_get(xs, i);
}

impl[T] IndexMut[mut [T]] {
  fn set_index(xs, i, x) = array_set(xs, i, x);
}

impl[T] Iterable[[T]] {
  type Iter = mut FnIter[T];
  fn iter(xs) {
    let mut next = 0;
    mut FnIter {
      next: || if next < array_len(xs) {
        next += 1;
        Some(array_get(xs, next - 1))
      } else {
        None
      },
    }
  }
}
