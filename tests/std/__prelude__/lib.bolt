// A small prelude for the tests in `tests/`, which a case gets with the
// attribute `:test-prelude`: the classes that syntax uses, `xs[i]`,
// `xs[i] = x`, `for x in xs`, and the operators like `a + b` and `a == b`,
// with their impls for the primitive types, arrays, tuples, `String` and
// `Char`, the types of string and character literals, `Debug`, which the
// evaluator shows characters with, `ToImmDeep`, which `imm e` copies with,
// `Cont` and `resume` for handlers, and a few functions the compiler
// provides. It's a copy of what `packages/std` has of them, so that a case
// that only needs these doesn't change when `std` does.

extern "bolt" {

  /// Write `text` and a newline.
  pub fn print(text: String);

  /// Stop the program with an error, at once.
  pub fn abort() -> !;

  /// The number of elements of `xs`.
  pub fn array_len[T](xs: [T]) -> i32;

  pub(package) fn array_get[T](xs: [T], i: i32) -> T;

  pub(package) fn array_set[T](xs: mut [T], i: i32, x: T);

  /// A new array of `len` elements that aren't set yet.
  pub(package) fn array_alloc[T](len: i32) -> mut [T];

  /// A copy of `xs` that can't be changed.
  pub(package) fn array_freeze[T](xs: [T]) -> imm [T];

}

/// Stop the program with an error, after writing `message`.
pub fn panic(message: String) -> ! {
  print(message);
  abort()
}

