impl Neg[i128] { fn neg(a) = i128_neg(a); }
impl Neg[isize] { fn neg(a) = isize_neg(a); }
impl Neg[f32] { fn neg(a) = f32_neg(a); }
impl Neg[f64] { fn neg(a) = f64_neg(a); }

pub fn -a = neg(a);

/// Logical negation: `!a`.
pub class Not[T] {
  /// The type of the result.
  type Output = T;

  fn not(a: T) -> Output;
}

impl Not[Bool] { fn not(a) = bool_not(a); }

pub fn !a = not(a);

/// Text, as its bytes in UTF-8, like `std`'s `String`: the type of string
/// literals, and what `print` and `panic` take.
pub imm struct String([u8]);

impl Eq[String] {
  fn eq(a, b) {
    if array_len(a.0) != array_len(b.0) {
      return False;
    }
    let mut i = 0;
    while i < array_len(a.0) {
      if array_get(a.0, i) != array_get(b.0, i) {
        return False;
      }
      i += 1;
    }
    True
  }
}

/// A character, like `std`'s `Char`: the type of character literals, which
/// holds its code point.
pub imm struct Char(u32);

impl Eq[Char] {
  fn eq(a, b) = a.0 == b.0;
}

/// How values look in code, like `std`'s `Debug`, but giving a `String`.
/// The evaluator shows values of types with an impl with `debug_string`.
pub class Debug[T] {
  fn debug(x: T) -> String;
}

pub fn debug_string[T](x: T) -> String where Debug[T] = debug(x);

/// Characters look like `'a'`. Only ASCII ones without escapes, which is
/// what the tests show.
impl Debug[Char] {
  fn debug(c) = String([39, c.0 as u8, 39]);
}

pub enum Option[T] {
  None,
  Some(T),
}

pub import Option.*;

impl[T] Eq[Option[T]] where Eq[T] {
  fn eq(a, b) = match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => True,
    _ => False,
  };
}

/// Types that have a copy that can't be changed all the way down, which
/// `imm e` makes with `to_imm_deep`.
pub class ToImmDeep[T] {
  fn to_imm_deep(x: T) -> imm T;
}

impl ToImmDeep[Bool] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i8] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i16] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i128] { fn to_imm_deep(x) = x; }
impl ToImmDeep[isize] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u8] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u16] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u128] { fn to_imm_deep(x) = x; }
impl ToImmDeep[usize] { fn to_imm_deep(x) = x; }
impl ToImmDeep[f32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[f64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[()] { fn to_imm_deep(x) = x; }
impl ToImmDeep[Char] { fn to_imm_deep(c) = c; }
impl ToImmDeep[String] { fn to_imm_deep(s) = s; }
impl ToImmDeep[Ordering] { fn to_imm_deep(o) = o; }

impl[A: ToImmDeep, B: ToImmDeep] ToImmDeep[(A, B)] {
  fn to_imm_deep(p) = match p { (a, b) => (to_imm_deep(a), to_imm_deep(b)) };
}

impl[A: ToImmDeep, B: ToImmDeep, C: ToImmDeep] ToImmDeep[(A, B, C)] {
  fn to_imm_deep(t) = match t {
    (a, b, c) => (to_imm_deep(a), to_imm_deep(b), to_imm_deep(c)),
  };
}

impl[T: ToImmDeep] ToImmDeep[[T]] {
  fn to_imm_deep(xs) {
    let n = array_len(xs);
    let ys = array_alloc(n);
    let mut i = 0;
    while i < n {
      array_set(ys, i, to_imm_deep(array_get(xs, i)));
      i = i + 1;
    }
    array_freeze(ys)
  }
}

impl[T: ToImmDeep] ToImmDeep[Option[T]] {
  fn to_imm_deep(o) = match o {
    None => None,
    Some(x) => Some(to_imm_deep(x)),
  };
}

/// Types whose elements can be read by position, with `c[i]`.
pub class Index[C] {
  type Item;
  fn index(c: C, i: i32) -> Item;
}

/// Types whose elements can be replaced by position, with `c[i] = x`.
pub class IndexMut[C] where Index[C] {
  fn set_index(c: C, i: i32, x: C.Item);
}

/// Types that give their items one at a time, until there are none left.
pub class Iterator[I] {
  type Item;
  fn next(it: I) -> Option[Item];
}

/// Types that can be looped over with `for x in c`.
pub class Iterable[C] {
  type Iter: Iterator;
  fn iter(c: C) -> Iter;
}

impl[T] Index[[T]] {
  type Item = T;
  fn index(xs, i) = array_get(xs, i);
}

impl[T] IndexMut[mut [T]] {
  fn set_index(xs, i, x) = array_set(xs, i, x);
}

pub struct ArrayIter[T, 'v] {
  array: 'v [T],
  index: i32,
}

impl[T] Iterator[mut ArrayIter[T]] {

  type Item = T;

  fn next(self) -> Option[T] {
    if self.index < array_len(self.array) {
      self.index += 1;
      Some(array_get(self.array, self.index - 1))
    } else {
      None
    }
  }

}

/// `for x in xs`: the elements, in order. A change the loop makes to an
/// element it hasn't reached yet is seen when it gets there.
impl[T, 'v] Iterable['v [T]] {
  type Iter = mut ArrayIter[T, 'v];
  fn iter(array) = mut ArrayIter { array, index: 0 };
}

/// The `k` of an effect arm: see `packages/std/effect.bolt`.
pub imm struct Cont[B, U, R] {
  resume: fn(B) -> U does R,
}

extern "bolt" {
  pub fn resume[B, U, R](k: Cont[B, U, R], value: B) -> U does R;
}
