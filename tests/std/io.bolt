import "./string" (String);

/// Write `bytes` to the file `fd`, as `std`'s `sys/emu.bolt` does: an error
/// number, and how many bytes it wrote.
#[link(emu, abi = flat)]
fn write(fd: i32, bytes: [u8]) -> (u16, i32);

/// Write `text` and a newline to stdout.
pub fn print(text: String) {
  write(1, text.0);
  write(1, "\n".0);
}

/// Write `text` and a newline to stderr.
pub fn eprint(text: String) {
  write(2, text.0);
  write(2, "\n".0);
}

/// Stop the program with an error, at once.
#[builtin]
pub fn abort() -> !;

/// Stop the program with an error, after writing `message` to stderr.
pub fn panic(message: String) -> ! {
  eprint(message);
  abort()
}
