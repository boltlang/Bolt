// A growable array.

import "./mutability" (ToMut, ToImm, to_mut, to_imm);
import "./option" (Option, None, Some);
import "./ops" (Eq, Index, IndexMut);
import "./array" (array_alloc, array_copy, array_freeze, array_len);
import "./iter" (Iterable, Iterator, zip);
import "./io" (panic, assert);


/// An array that grows: `push` adds an element at the end, and makes room
/// when there's none left.
///
/// The elements are the first `len` of `items`. The rest of `items` is room
/// to grow into, and isn't set.
pub struct Vec[T] {
  items: [T],
  len: i32,
}

/// A new, empty `Vec`.
pub fn Vec.new[T]() -> mut Vec[T] = Vec.with_capacity(0);

/// A new, empty `Vec` with room for `capacity` elements.
pub fn Vec.with_capacity[T](capacity: i32) -> mut Vec[T] {
  if capacity < 0 {
    panic("a capacity can't be negative");
  }
  mut Vec { items: array_alloc(capacity), len: 0 }
}

/// A new `Vec` with the elements of `xs`.
pub fn Vec.from_array[T](xs: [T]) -> mut Vec[T] {
  let n = array_len(xs);
  let v = Vec.with_capacity(n);
  array_copy(v.items, 0, xs, 0, n);
  v.len = n;
  v
}

/// The number of elements.
pub fn len[T](v: Vec[T]) -> i32 = v.len;

/// Whether there are no elements.
pub fn is_empty[T](v: Vec[T]) -> Bool = v.len == 0;

/// How many elements fit before `v` needs more room.
pub fn capacity[T](v: Vec[T]) -> i32 = array_len(v.items);

/// The element at `index`.
pub fn get[T](v: Vec[T], index: i32) -> T {
  check_index(v, index);
  v.items[index]
}

/// The element at `index`, or `None` if there's none.
pub fn try_get[T](v: Vec[T], index: i32) -> Option[T] {
  if index < 0 || index >= v.len {
    return None;
  }
  Some(v.items[index])
}

/// Replace the element at `index` with `x`.
pub fn set[T](v: mut Vec[T], index: i32, x: T) {
  check_index(v, index);
  v.items[index] = x;
}

/// Add `x` at the end.
pub fn push[T](v: mut Vec[T], x: T) {
  if v.len == capacity(v) {
    grow(v, v.len + 1);
  }
  v.items[v.len] = x;
  v.len += 1;
}

pub fn first[T](v: Vec[T]) -> Option[T] {
  if v.len == 0 {
    None
  } else {
    Some(v.items[0])
  }
}

pub fn last[T](v: Vec[T]) -> Option[T] {
  if v.len == 0 {
    None
  } else {
    Some(v.items[v.len-1])
  }
}

pub fn extend[T, I: Iterable[Item = T]](v: mut Vec[T], it: I) {
  for item in it {
    v.push(item);
  }
}

/// Remove the last element and give it, or `None` if there's none.
pub fn pop[T](v: mut Vec[T]) -> Option[T] {
  if v.len == 0 {
    return None;
  }
  v.len -= 1;
  Some(v.items[v.len])
}

/// Put `x` at `index`, moving the elements from there one place up.
/// `index` can be `len(v)`, to add `x` at the end.
pub fn insert[T](v: mut Vec[T], index: i32, x: T) {
  if index < 0 || index > v.len {
    panic("index out of bounds");
  }
  if v.len == capacity(v) {
    grow(v, v.len + 1);
  }
  array_copy(v.items, index + 1, v.items, index, v.len - index);
  v.items[index] = x;
  v.len += 1;
}

/// Remove the element at `index` and give it, moving the elements after it
/// one place down.
pub fn remove[T](v: mut Vec[T], index: i32) -> T {
  check_index(v, index);
  let x = v.items[index];
  array_copy(v.items, index, v.items, index + 1, v.len - index - 1);
  v.len -= 1;
  x
}

/// Remove all elements, keeping the room they took.
pub fn clear[T](v: mut Vec[T]) {
  v.len = 0;
}

/// Make room for at least `additional` more elements.
pub fn reserve[T](v: mut Vec[T], additional: i32) {
  if v.len + additional > capacity(v) {
    grow(v, v.len + additional);
  }
}

/// A new array with the elements of `v`.
pub fn to_array[T](v: Vec[T]) -> mut [T] {
  let xs = array_alloc(v.len);
  array_copy(xs, 0, v.items, 0, v.len);
  xs
}

fn check_index[T](v: Vec[T], index: i32) {
  if index < 0 || index >= v.len {
    panic("index out of bounds");
  }
}

/// Move the elements to a new array with room for at least `needed`, at
/// least twice the old room, so that adding `n` elements one at a time
/// copies O(n) elements in all.
fn grow[T](v: mut Vec[T], needed: i32) {
  let mut new_capacity = capacity(v) * 2;
  if new_capacity < 4 {
    new_capacity = 4;
  }
  while new_capacity < needed {
    new_capacity *= 2;
  }
  let items = array_alloc(new_capacity);
  array_copy(items, 0, v.items, 0, v.len);
  v.items = items;
}

impl[T] Eq[Vec[T]] where Eq[T] {
  fn eq(a, b) {
    if a.len != b.len {
      return False;
    }
    for (x, y) in zip(a, b) {
      if x != y {
        return False;
      }
    }
    return True;
  }
}

/// `v[i]`: the element at `i`.
impl[T] Index[Vec[T]] {
  type Item = T;
  fn index(v, i) = get(v, i);
}

/// `v[i] = x`: replace the element at `i`.
impl[T] IndexMut[mut Vec[T]] {
  fn set_index(v, i, x) = set(v, i, x);
}

pub struct VecIter[T, 'v] {
  data: 'v Vec[T],
  index: i32,
}

impl[T] Iterator[mut VecIter[T]] {

  type Item = T;

  fn next(self) {
    if self.index < self.data.len {
      self.index += 1;
      Some(self.data.items[self.index - 1])
    } else {
      None
    }
  }

}

/// `for x in v`: the elements, in order. Elements pushed while the loop
/// runs are included.
impl[T, 'v] Iterable['v Vec[T]] {

  type Iter = mut VecIter[T, 'v];

  fn iter(data) = mut VecIter { data, index: 0 };

}

/// A copy of a `Vec` that can be changed, with as much room as the
/// original.
impl[T] ToMut[Vec[T]] {
  type Mut = mut Vec[T];
  fn to_mut(v) {
    let items = array_alloc(capacity(v));
    array_copy(items, 0, v.items, 0, v.len);
    mut Vec { items, len: v.len }
  }
}

/// A copy of a `Vec` that can't be changed. The elements of an `imm` one
/// aren't copied: its buffer is `imm` too, and `array_freeze` gives it back
/// as it is.
impl[T: imm] ToImm[Vec[T]] {
  type Imm = imm Vec[T];
  fn to_imm(v) = Vec { items: array_freeze(v.items), len: v.len };
}

// Tests

#[test]
fn pushing_and_popping() {
  let v = Vec.new();
  v.push(1);
  v.push(2);
  v.push(3);
  assert(v.pop() == Some(3));
  assert(len(v) == 2);
  assert(to_array(v) == mut [1, 2]);
}

#[test]
fn popping_an_empty_vec() {
  let v: Vec[i32] = Vec.new();
  assert(v.pop() == None);
  assert(v.is_empty());
}

#[test]
fn growing_doubles_the_room() {
  let v = Vec.new();
  let mut i = 0;
  while i < 100 {
    v.push(i);
    i += 1;
  }
  assert(len(v) == 100);
  assert(capacity(v) == 128);
  assert(v.get(0) == 0);
  assert(v.get(99) == 99);
}

#[test]
fn getting_and_setting() {
  let v = Vec.from_array([1, 2, 3]);
  v.set(1, 20);
  assert(v.get(1) == 20);
  assert(v.try_get(3) == None);
  assert(v.try_get(-1) == None);
  assert(v.try_get(2) == Some(3));
}

#[test]
fn inserting_and_removing() {
  let v = Vec.from_array([1, 2, 3]);
  v.insert(0, 0);
  v.insert(4, 4);
  v.insert(2, 9);
  assert(v.remove(2) == 9);
  assert(to_array(v) == mut [0, 1, 2, 3, 4]);
}

#[test]
fn clearing_keeps_the_room() {
  let v = Vec.from_array([1, 2, 3]);
  let room = capacity(v);
  v.clear();
  assert(len(v) == 0);
  assert(capacity(v) == room);
}

#[test]
fn reserving_room() {
  let v: Vec[i32] = Vec.new();
  v.reserve(10);
  let room = capacity(v);
  let mut i = 0;
  while i < 10 {
    v.push(i);
    i += 1;
  }
  assert(room >= 10);
  assert(capacity(v) == room);
}

#[test]
fn a_vec_is_shared_and_to_array_copies() {
  let v = Vec.from_array([1, 2]);
  let w = v;
  w.push(3);
  let xs = to_array(v);
  xs[0] = 9;
  assert(to_array(v) == mut [1, 2, 3]);
  assert(xs == mut [9, 2, 3]);
}

fn test_fill(v: mut Vec[String], n: i32) {
  let mut i = 0;
  while i < n {
    v.push("x");
    i += 1;
  }
}

#[test]
fn a_function_fills_in_a_vec_it_s_given() {
  let v = Vec.new();
  test_fill(v, 3);
  assert(to_array(v) == mut ["x", "x", "x"]);
}

#[test]
fn indexing_a_vec() {
  let v = Vec.from_array([1, 2, 3]);
  v[0] = 10;
  v[1] += 5;
  assert(v[0] == 10);
  assert(v[1] == 7);
  assert(v[2] == 3);
}

struct TestPoint { x: i32, y: i32 }

#[test]
fn changing_a_part_of_an_element_of_a_vec() {
  let points = Vec.from_array(mut [mut TestPoint { x: 0, y: 0 }]);
  points[0].x = 3;
  let pairs = Vec.from_array([(1, 2)]);
  pairs[0].1 = 5;
  assert(points[0].x == 3);
  assert(points[0].y == 0);
  assert(pairs[0] == (1, 5));
}

#[test]
fn looping_over_a_vec() {
  let v = Vec.from_array([1, 2, 3]);
  let mut total = 0;
  for x in v {
    total += x;
  }
  assert(total == 6);
}

#[test]
fn a_loop_over_a_vec_sees_elements_pushed_while_it_runs() {
  let v = Vec.from_array([1]);
  let mut seen = 0;
  for x in v {
    seen += 1;
    if x < 3 {
      v.push(x + 1);
    }
  }
  assert(seen == 3);
  assert(to_array(v) == mut [1, 2, 3]);
}

fn test_first[C](c: C) -> C.Item where Index[C] = c[0];

fn test_count[C](c: C) -> i32 where Iterable[C], Iterator[C.Iter] {
  let mut n = 0;
  for x in c {
    n += 1;
  }
  n
}

#[test]
fn generic_functions_over_indexing_and_loops() {
  let v = Vec.from_array(["a", "b"]);
  assert(test_first(v) == "a");
  assert(test_count(v) == 2);
}

#[test]
fn comparing_vecs_compares_their_elements() {
  let a = Vec.from_array([1, 2, 3]);
  let b = Vec.from_array([1, 2, 3]).to_mut();
  let c = Vec.from_array([1, 2]);
  let d = Vec.from_array([1, 2, 4]);
  assert(a == b);
  assert(!(a == c));
  assert(!(a == d));
  assert(a != d);
}

#[test]
fn a_copy_of_a_vec_that_can_be_changed() {
  let v = Vec.from_array([1, 2]);
  let w = to_mut(v);
  w.push(3);
  assert(to_array(v) == mut [1, 2]);
  assert(to_array(w) == mut [1, 2, 3]);
}

#[test]
fn a_copy_of_a_vec_that_can_t_be_changed() {
  let v = Vec.from_array([1, 2]);
  let f = to_imm(v);
  v.push(3);
  assert(to_array(v) == mut [1, 2, 3]);
  assert(len(f) == 2);
  assert(f[0] == 1);
}
