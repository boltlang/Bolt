// Arrays: the functions on them that the compiler provides, and the impls
// that make `xs[i]`, `xs[i] = x` and `for x in xs` work on them.

import "./classes" (Index, IndexMut, Iterable, FnIter);
import "./option" (Option, Some, None);
import "./mutability" (ToMut, ToImm);

extern "bolt" {

  /// The number of elements of `xs`.
  pub fn array_len[T](xs: [T]) -> i32;

  /// A new array of `len` elements that aren't set yet. Reading one before
  /// it's set stops the program, so it's only for `std`, for types that
  /// keep track of which elements are set, like `Vec`.
  pub(package) fn array_alloc[T](len: i32) -> mut [T];

  /// The element at `i`. Use `xs[i]` instead.
  pub(package) fn array_get[T](xs: [T], i: i32) -> T;

  /// Replace the element at `i` with `x`. Use `xs[i] = x` instead.
  pub(package) fn array_set[T](xs: mut [T], i: i32, x: T);

  /// Copy `count` elements of `src` from `src_start` to `dst` from
  /// `dst_start`. `src` and `dst` can be the same array, and the ranges can
  /// overlap.
  pub fn array_copy[T](dst: mut [T], dst_start: i32, src: [T], src_start: i32, count: i32);

  /// A copy of `xs` that can't be changed. Use `to_imm(xs)` instead.
  pub(package) fn array_freeze[T](xs: [T]) -> imm [T];

}

/// `xs[i]`: the element at `i`.
impl[T] Index[[T]] {
  type Item = T;
  fn index(xs, i) = array_get(xs, i);
}

/// `xs[i] = x`: replace the element at `i`.
impl[T] IndexMut[mut [T]] {
  fn set_index(xs, i, x) = array_set(xs, i, x);
}

/// `for x in xs`: the elements, in order. A change the loop makes to an
/// element it hasn't reached yet is seen when it gets there.
impl[T] Iterable[[T]] {
  type Iter = mut FnIter[T];
  fn iter(xs) {
    let mut next = 0;
    mut FnIter {
      next: || if next < array_len(xs) {
        next += 1;
        Some(array_get(xs, next - 1))
      } else {
        None
      },
    }
  }
}

/// A copy of an array that can be changed.
impl[T] ToMut[[T]] {
  type Mut = mut [T];
  fn to_mut(xs) {
    let n = array_len(xs);
    let ys = array_alloc(n);
    array_copy(ys, 0, xs, 0, n);
    ys
  }
}

/// A copy of an array that can't be changed.
impl[T] ToImm[[T]] {
  type Imm = imm [T];
  fn to_imm(xs) = array_freeze(xs);
}
