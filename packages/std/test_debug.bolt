// The tests of `debug.bolt`, and of the impls of `Debug` of `char.bolt` and
// `string.bolt`.

import "./debug" *;
import "./char" (Char);
import "./string" *;
import "./option" (unwrap);
import "./io" (assert);
import "./ops" *;

#[test]
fn characters_look_like_their_literals() {
  assert(repr('a') == "'a'");
  assert(repr('é') == "'é'");
  assert(repr('"') == "'\"'");
  assert(repr('\'') == "'\\''");
  assert(repr('\\') == "'\\\\'");
  assert(repr('\n') == "'\\n'");
  assert(repr('\t') == "'\\t'");
  assert(repr('\0') == "'\\0'");
}

#[test]
fn other_control_characters_look_like_unicode_escapes() {
  assert(repr(unwrap(Char.from_u32(0x1B))) == "'\\u{1b}'");
  assert(repr(unwrap(Char.from_u32(0x7F))) == "'\\u{7f}'");
  assert(repr(unwrap(Char.from_u32(0x01))) == "'\\u{1}'");
}

#[test]
fn strings_look_like_their_literals() {
  assert(repr("hi") == "\"hi\"");
  assert(repr("") == "\"\"");
  assert(repr("it's") == "\"it's\"");
  assert(repr("a \"b\"\n") == "\"a \\\"b\\\"\\n\"");
  assert(repr("wörld ✓") == "\"wörld ✓\"");
}

struct Point { x: i32, y: i32 }

impl Debug[Point] {
  fn debug(p, out) = out.push_str("<point>");
}

#[test]
fn a_type_can_have_an_impl_of_its_own() {
  assert(repr(Point { x: 1, y: 2 }) == "<point>");
}

#[test]
fn booleans_look_like_their_literals() {
  assert(repr(True) == "True");
  assert(repr(False) == "False");
}
