// The tests of `ops.bolt`.

import "./ops" *;
import "./io" (assert);
import "./option" (Some, None);

/// What the classes give generic code: the operator of the type it's
/// called with.
fn twice[T: Add](x: T) -> T.Output = add(x, x);

struct Money { cents: i32 }

impl Add[Money] {
  type Output = Money;
  fn add(a, b) = Money { cents: a.cents + b.cents };
}

impl Neg[Money] {
  type Output = Money;
  fn neg(a) = Money { cents: 0 - a.cents };
}

impl Sub[Money] {
  type Output = Money;
  fn sub(a, b) = Money { cents: a.cents - b.cents };
}

impl Shl[Money] {
  type Output = Money;
  fn shl(a, n) = Money { cents: a.cents * 10 };
}

struct Switch { on: Bool }

impl Not[Switch] {
  type Output = Switch;
  fn not(s) = Switch { on: !s.on };
}

/// Generic code with the operator, not the class method.
fn doubled[T: Add](x: T) -> T.Output = x + x;

#[test]
fn the_primitive_types_have_the_operators() {
  assert(add(2, 3) == 5);
  assert(sub(2u8, 1u8) == 1u8);
  assert(mul(2.5, 2.0) == 5.0);
  assert(div(7i64, 2i64) == 3i64);
  assert(rem(-7, 2) == -1);
  assert(neg(4) == -4);
  assert(not(False));
  assert(bitand(6, 3) == 2);
  assert(bitxor(True, True) == False);
  assert(shl(1u8, 3) == 8u8);
  assert(shr(-8, 1) == -4);
  assert(eq('a', 'a') && ne(1.5, 2.5));
}

/// Generic code that orders values through the classes, not the builtins.
fn smaller[T: PartialOrd](a: T, b: T) -> T = if lt(a, b) { a } else { b };

#[test]
fn the_primitive_types_are_ordered() {
  assert(cmp(1, 2) == Ordering.Less);
  assert(cmp(-3i64, -3i64) == Ordering.Equal);
  assert(cmp(200u8, 100u8) == Ordering.Greater);
  assert(cmp('b', 'a') == Ordering.Greater);
  assert(cmp(False, True) == Ordering.Less);
  assert(partial_cmp(7u32, 9u32) == Some(Ordering.Less));
}

// TODO: also order numbers in generic code, once the evaluator can tell
// which impl a number in generic code uses.
#[test]
fn the_comparison_classes_come_from_partial_ord() {
  assert(lt('a', 'b') && lte('b', 'b') && gt('c', 'b') && gte('c', 'c'));
  assert(!lt(True, False) && !gte(False, True));
  assert(smaller('x', 'q') == 'q');
}

#[test]
fn floats_are_only_partially_ordered() {
  let nan = 0.0 / 0.0;
  assert(partial_cmp(1.5, 2.5) == Some(Ordering.Less));
  assert(partial_cmp(2.0f32, 2.0f32) == Some(Ordering.Equal));
  assert(partial_cmp(3.5, -1.0) == Some(Ordering.Greater));
  assert(partial_cmp(nan, 1.0) == None);
  assert(partial_cmp(nan, nan) == None);
}

#[test]
fn a_type_with_an_impl_has_the_operator() {
  assert(add(Money { cents: 1 }, Money { cents: 2 }).cents == 3);
  assert(neg(Money { cents: 5 }).cents == -5);
  assert(twice(Money { cents: 150 }).cents == 300);
}

#[test]
fn the_operators_of_a_type_call_its_impls() {
  assert((Money { cents: 1 } + Money { cents: 2 }).cents == 3);
  assert((Money { cents: 5 } - Money { cents: 2 }).cents == 3);
  assert((Money { cents: 3 } << 1).cents == 30);
  assert(doubled(Money { cents: 150 }).cents == 300);
}

#[test]
fn prefix_operators_call_their_impls_too() {
  assert((-Money { cents: 5 }).cents == -5);
  assert((-(Money { cents: 5 } - Money { cents: 7 })).cents == 2);
  assert((!Switch { on: True }).on == False);
}

#[test]
fn compound_assignments_call_the_impls() {
  let mut m = Money { cents: 1 };
  m += Money { cents: 2 };
  m -= Money { cents: 1 };
  assert(m.cents == 2);
  let mut t = (Money { cents: 5 }, 0);
  t.0 += Money { cents: 5 };
  assert(t.0.cents == 10);
}
