// The tests of `option.bolt`.

import "./option" *;
import "./ops" *;
import "./io" (assert);

fn test_safe_div(a: i32, b: i32) -> Option[i32] = if b == 0 { None } else { Some(a / b) };

#[test]
fn some_and_none() {
  assert(test_safe_div(7, 2) == Some(3));
  assert(test_safe_div(7, 0) == None);
  assert(match test_safe_div(7, 2) { Some(n) => n, None => -1 } == 3);
}

#[test]
fn unwrapping_some() {
  assert(unwrap(Some(1)) == 1);
}

fn sum_of_quotients(a: i32, b: i32, c: i32) -> Option[i32] {
  let x = test_safe_div(a, b)?;
  Some(x + test_safe_div(a, c)?)
}

#[test]
fn question_mark_gives_the_value_of_a_some_or_returns_none() {
  assert(sum_of_quotients(12, 3, 4) == Some(7));
  assert(sum_of_quotients(12, 0, 4) == None);
  assert(sum_of_quotients(12, 3, 0) == None);
}

#[test]
fn options_are_equal_when_their_values_are() {
  assert(Some(1) == Some(1));
  assert(Some(1) != Some(2));
  assert(Some(1) != None);
  assert([Some(1)] == [Some(1)]);
}
