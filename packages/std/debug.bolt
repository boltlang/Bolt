// How values look in code, like Rust's `Debug`: `'a'` for a character and
// `"hi"` for a string. The evaluator shows the values of types with an impl
// with it, like the result of `bolt run`, and others as they are, like
// `Some(1)`.

import "./string" (String, StringBuilder, push, push_str, build);
import "./char" (Char);
import "./ops" *;

/// Types whose values can be shown as they look in code.
pub class Debug[T] {
  /// Add how `x` looks to the end of `out`.
  fn debug(x: T, out: mut StringBuilder);
}

/// How `x` looks in code, as a `String`.
pub fn debug_string[T](x: T) -> String where Debug[T] {
  let out = StringBuilder.new();
  debug(x, out);
  out.build()
}

/// Add `n` in hexadecimal to the end of `out`, with lowercase letters and
/// without leading zeros, like the `7f` of `'\u{7f}'`.
pub(package) fn push_hex(out: mut StringBuilder, n: u32) {
  if n >= 16 {
    push_hex(out, n >> 4);
  }
  let digit = n & 0xF;
  out.push(Char(if digit < 10 { 0x30 + digit } else { 0x57 + digit }));
}

/// Add `n` in decimal to the end of `out`.
pub(package) fn push_u64(out: mut StringBuilder, n: u64) {
  if n >= 10 {
    push_u64(out, n / 10);
  }
  let digit = (n % 10) as u32;
  out.push(Char(0x30 + digit));
}

/// Add `n` in decimal to the end of `out`, with a `-` when it's negative.
pub(package) fn push_i64(out: mut StringBuilder, n: i64) {
  if n < 0 {
    out.push('-');
    // Not `-n`, which overflows for the smallest `i64`.
    push_u64(out, ((-(n + 1)) as u64) + 1);
  } else {
    push_u64(out, n as u64);
  }
}

/// Add `n` in decimal to the end of `out`.
pub(package) fn push_u128(out: mut StringBuilder, n: u128) {
  if n >= 10 {
    push_u128(out, n / 10);
  }
  let digit = (n % 10) as u32;
  out.push(Char(0x30 + digit));
}

/// Add `n` in decimal to the end of `out`, with a `-` when it's negative.
pub(package) fn push_i128(out: mut StringBuilder, n: i128) {
  if n < 0 {
    out.push('-');
    push_u128(out, ((-(n + 1)) as u128) + 1);
  } else {
    push_u128(out, n as u128);
  }
}

// Integers look like their literals without a suffix, like `-42`.
impl Debug[i8] { fn debug(n, out) = push_i64(out, n as i64); }
impl Debug[i16] { fn debug(n, out) = push_i64(out, n as i64); }
impl Debug[i32] { fn debug(n, out) = push_i64(out, n as i64); }
impl Debug[i64] { fn debug(n, out) = push_i64(out, n); }
impl Debug[i128] { fn debug(n, out) = push_i128(out, n); }
impl Debug[isize] { fn debug(n, out) = push_i64(out, n as i64); }
impl Debug[u8] { fn debug(n, out) = push_u64(out, n as u64); }
impl Debug[u16] { fn debug(n, out) = push_u64(out, n as u64); }
impl Debug[u32] { fn debug(n, out) = push_u64(out, n as u64); }
impl Debug[u64] { fn debug(n, out) = push_u64(out, n); }
impl Debug[u128] { fn debug(n, out) = push_u128(out, n); }
impl Debug[usize] { fn debug(n, out) = push_u64(out, n as u64); }

/// `True` or `False`, as in code.
impl Debug[Bool] {
  fn debug(b, out) = out.push_str(if b { "True" } else { "False" });
}
