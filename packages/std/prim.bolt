// The operations of the primitive types, as functions: what the operators
// do on each type, like `i32_add` for `+` on `i32`. They're for the impls
// of the classes of `ops.bolt`; code outside `std` uses the operators.

extern "bolt" {
  // Bool
  pub(package) fn bool_bitand(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_bitor(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_bitxor(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_not(a: Bool) -> Bool;
  pub(package) fn bool_eq(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_ne(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_lt(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_le(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_gt(a: Bool, b: Bool) -> Bool;
  pub(package) fn bool_ge(a: Bool, b: Bool) -> Bool;

  // String
  pub(package) fn string_add(a: String, b: String) -> String;
  pub(package) fn string_eq(a: String, b: String) -> Bool;
  pub(package) fn string_ne(a: String, b: String) -> Bool;
  pub(package) fn string_lt(a: String, b: String) -> Bool;
  pub(package) fn string_le(a: String, b: String) -> Bool;
  pub(package) fn string_gt(a: String, b: String) -> Bool;
  pub(package) fn string_ge(a: String, b: String) -> Bool;

