
import "./mutability" (to_mut, to_imm);
import "./option" (Some, unwrap);
import "./vec" (Vec, last, push, extend);
import "./ops" (PartialOrd, Eq, Ordering, eq);
import "./semigroup" (Semigroup);
import "./char" (Char, to_utf8, push_escaped);
import "./debug" (Debug);

/// Text, as its bytes in UTF-8. It's never changed in place, so it's an
/// `imm struct`: a `String` is always `imm`.
pub imm struct String(Vec[u8]);

pub fn String.from_bytes(bytes: imm Vec[u8]) -> String {
  String(bytes)
}

/// Strings are equal when their bytes are.
impl Eq[String] {
  fn eq(a, b) = eq(a.0, b.0);
}

/// Whether `a` comes before `b`, is equal to it or comes after it, byte by
/// byte: for UTF-8, that's the order of the characters.
fn compare(a: String, b: String) -> Ordering {
  let x = a.0;
  let y = b.0;
  let mut i = 0;
  while i < x.len && i < y.len {
    if x[i] != y[i] {
      return if x[i] < y[i] { Ordering.Less } else { Ordering.Greater };
    }
    i += 1;
  }
  if x.len < y.len { Ordering.Less } else if x.len > y.len { Ordering.Greater } else { Ordering.Equal }
}

impl PartialOrd[String] {
  fn partial_cmp(a, b) = Some(compare(a, b));
}

/// Strings look like `"hi"`, with `\` before `"` and the escapes of
/// characters, like `\n`.
impl Debug[String] {
  fn debug(s, out) {
    out.push('"');
    for byte in s.0 {
      if byte == b'"' {
        out.push_str("\\\"");
      } else if byte < 0x80 {
        push_escaped(out, Char(byte as u32));
      } else {
        // The bytes of a character that isn't ASCII, which is as it is.
        out.bytes.push(byte);
      }
    }
    out.push('"');
  }
}

/// Joining strings, with `a <> b`.
impl Semigroup[String] {
  fn concat(a, b) {
    let joined = StringBuilder.new();
    joined.push_str(a);
    joined.push_str(b);
    joined.build()
  }
}

/// Builds a `String` a piece at a time, without copying what it has so far
/// for each piece.
///
/// ```bolt
/// let b = StringBuilder.new();
/// b.push('h');
/// b.push_str(greeting);
/// let s = b.build();
/// ```
pub struct StringBuilder {
  bytes: Vec[u8],
}

/// A new, empty builder.
pub fn StringBuilder.new() -> mut StringBuilder {
  mut StringBuilder { bytes: Vec.new() }
}

/// Add the character `c` at the end.
pub fn push(b: mut StringBuilder, c: Char) {
  b.bytes.extend(c.to_utf8());
}

/// Add the text of `s` at the end.
pub fn push_str(b: mut StringBuilder, s: String) {
  b.bytes.extend(s.0);
}

/// The number of bytes added so far.
pub fn len(b: StringBuilder) -> i32 = b.bytes.len;

/// The text added so far, as a `String`. It's a copy, so the builder can
/// still be added to without changing it.
pub fn build(b: StringBuilder) -> String {
  String.from_bytes(to_imm(b.bytes))
}
