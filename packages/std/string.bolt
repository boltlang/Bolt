
import "./mutability" (to_mut, to_imm);
import "./option" (unwrap);
import "./vec" (Vec, last, push, extend);
import "./ops" (Eq, Lt, Gt, LtE, GtE, eq);
import "./semigroup" (Semigroup);

/// A single Unicode code point.
pub type Char = u32;

/// The bytes of `ch` in UTF-8: one for ASCII, and up to four for others.
pub fn to_utf8(ch: Char) -> mut Vec[u8] {
  let c = ch as u32;
  let bytes = Vec.with_capacity(4);
  if c < 0x80 {
    bytes.push(c as u8);
  } else if c < 0x800 {
    bytes.push((0xC0 | (c >> 6)) as u8);
    bytes.push((0x80 | (c & 0x3F)) as u8);
  } else if c < 0x10000 {
    bytes.push((0xE0 | (c >> 12)) as u8);
    bytes.push((0x80 | ((c >> 6) & 0x3F)) as u8);
    bytes.push((0x80 | (c & 0x3F)) as u8);
  } else {
    bytes.push((0xF0 | (c >> 18)) as u8);
    bytes.push((0x80 | ((c >> 12) & 0x3F)) as u8);
    bytes.push((0x80 | ((c >> 6) & 0x3F)) as u8);
    bytes.push((0x80 | (c & 0x3F)) as u8);
  }
  bytes
}

/// Text, as its bytes in UTF-8. It's never changed in place, so it's an
/// `imm struct`: a `String` is always `imm`.
pub imm struct String(Vec[u8]);

pub fn String.from_bytes(bytes: imm Vec[u8]) -> String {
  String(bytes)
}

/// Strings are equal when their bytes are.
impl Eq[String] {
  fn eq(a, b) = eq(a.0, b.0);
}

/// -1, 0 or 1 as `a` comes before `b`, is equal to it or comes after it,
/// byte by byte: for UTF-8, that's the order of the characters.
fn compare(a: String, b: String) -> i32 {
  let x = a.0;
  let y = b.0;
  let mut i = 0;
  while i < x.len && i < y.len {
    if x[i] != y[i] {
      return if x[i] < y[i] { -1 } else { 1 };
    }
    i += 1;
  }
  if x.len < y.len { -1 } else if x.len > y.len { 1 } else { 0 }
}

impl Lt[String] { fn lt(a, b) = compare(a, b) < 0; }
impl Gt[String] { fn gt(a, b) = compare(a, b) > 0; }
impl LtE[String] { fn lte(a, b) = compare(a, b) <= 0; }
impl GtE[String] { fn gte(a, b) = compare(a, b) >= 0; }

/// Joining strings, with `a <> b`.
impl Semigroup[String] {
  fn concat(a, b) {
    let joined = StringBuilder.new();
    joined.push_str(a);
    joined.push_str(b);
    joined.build()
  }
}

/// Builds a `String` a piece at a time, without copying what it has so far
/// for each piece.
///
/// ```bolt
/// let b = StringBuilder.new();
/// b.push('h');
/// b.push_str(greeting);
/// let s = b.build();
/// ```
pub struct StringBuilder {
  bytes: Vec[u8],
}

/// A new, empty builder.
pub fn StringBuilder.new() -> mut StringBuilder {
  mut StringBuilder { bytes: Vec.new() }
}

/// Add the character `c` at the end.
pub fn push(b: mut StringBuilder, c: Char) {
  b.bytes.extend(to_utf8(c));
}

/// Add the text of `s` at the end.
pub fn push_str(b: mut StringBuilder, s: String) {
  b.bytes.extend(s.0);
}

/// The number of bytes added so far.
pub fn len(b: StringBuilder) -> i32 = b.bytes.len;

/// The text added so far, as a `String`. It's a copy, so the builder can
/// still be added to without changing it.
pub fn build(b: StringBuilder) -> String {
  String.from_bytes(to_imm(b.bytes))
}
