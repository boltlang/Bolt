// A value to start from, like `0`, `False` or an empty array.

import "./option" (Option, None);
import "./string" (String);
import "./vec" (Vec);

/// Types with a value to start from, of the mutability `'m`. `default`
/// makes a new one, of the mutability the caller asks for, so
/// `let xs: mut [i32] = default();` can be changed. An impl that leaves
/// `'m` out, like `impl Default[Bool]`, is for any mutability.
pub class Default[T, 'm] {
  /// A new value to start from.
  fn default() -> 'm T;
}

/// The empty array.
impl[T] Default[[T], 'm] {
  fn default() = 'm [];
}

/// The empty vector, which is only made `mut`.
impl[T] Default[Vec[T], mut] {
  fn default() = Vec.new();
}

/// `None`.
impl[T] Default[Option[T]] {
  fn default() = None;
}

impl Default[Bool] {
  fn default() = False;
}

impl Default[i32] {
  fn default() = 0;
}

impl Default[i64] {
  fn default() = 0;
}

impl Default[f64] {
  fn default() = 0.0;
}

/// The empty string.
impl Default[String] {
  fn default() = String.from_bytes([]);
}
