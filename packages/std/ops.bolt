impl Shr[u8] { fn shr(a, n) = u8_shr(a, n); }
impl Shr[u16] { fn shr(a, n) = u16_shr(a, n); }
impl Shr[u32] { fn shr(a, n) = u32_shr(a, n); }
impl Shr[u64] { fn shr(a, n) = u64_shr(a, n); }
impl Shr[u128] { fn shr(a, n) = u128_shr(a, n); }
impl Shr[usize] { fn shr(a, n) = usize_shr(a, n); }

pub fn a >> n = shr(a, n);

/// Negation: `-a`.
pub class Neg[T] {
  /// The type of the result.
  type Output = T;

  fn neg(a: T) -> Output;
}

impl Neg[i8] { fn neg(a) = i8_neg(a); }
impl Neg[i16] { fn neg(a) = i16_neg(a); }
impl Neg[i32] { fn neg(a) = i32_neg(a); }
impl Neg[i64] { fn neg(a) = i64_neg(a); }
impl Neg[i128] { fn neg(a) = i128_neg(a); }
impl Neg[isize] { fn neg(a) = isize_neg(a); }
impl Neg[f32] { fn neg(a) = f32_neg(a); }
impl Neg[f64] { fn neg(a) = f64_neg(a); }

