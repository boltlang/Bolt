// Classes that syntax uses: `v[i]`, `v[i] = x` and `for x in c` work on any
// type with an impl of them. Arrays have theirs in `array.bolt`.

import "./option" (Option, None, Some);
import "./io" (assert);
import "./prim" *;

/// Types whose elements can be read by position, with `c[i]`.
pub class Index[C] {
  /// The type of the elements.
  type Item;

  /// The element at `i`, for `c[i]`.
  fn index(c: C, i: i32) -> Item;
}

/// Types whose elements can be replaced by position, with `c[i] = x`.
pub class IndexMut[C] where Index[C] {
  /// Replace the element at `i` with `x`, for `c[i] = x`.
  fn set_index(c: C, i: i32, x: C.Item);
}

/// Types whose values can be compared, with `a == b` and `a != b`.
pub class Eq[T] {
  fn eq(a: T, b: T) -> Bool;
  fn ne(a: T, b: T) -> Bool = !eq(a, b);
}

impl Eq[Bool] { fn eq(a, b) = bool_eq(a, b); fn ne(a, b) = bool_ne(a, b); }
impl Eq[i8] { fn eq(a, b) = i8_eq(a, b); fn ne(a, b) = i8_ne(a, b); }
impl Eq[i16] { fn eq(a, b) = i16_eq(a, b); fn ne(a, b) = i16_ne(a, b); }
impl Eq[i32] { fn eq(a, b) = i32_eq(a, b); fn ne(a, b) = i32_ne(a, b); }
impl Eq[i64] { fn eq(a, b) = i64_eq(a, b); fn ne(a, b) = i64_ne(a, b); }
impl Eq[i128] { fn eq(a, b) = i128_eq(a, b); fn ne(a, b) = i128_ne(a, b); }
impl Eq[isize] { fn eq(a, b) = isize_eq(a, b); fn ne(a, b) = isize_ne(a, b); }
impl Eq[u8] { fn eq(a, b) = u8_eq(a, b); fn ne(a, b) = u8_ne(a, b); }
impl Eq[u16] { fn eq(a, b) = u16_eq(a, b); fn ne(a, b) = u16_ne(a, b); }
impl Eq[u32] { fn eq(a, b) = u32_eq(a, b); fn ne(a, b) = u32_ne(a, b); }
impl Eq[u64] { fn eq(a, b) = u64_eq(a, b); fn ne(a, b) = u64_ne(a, b); }
impl Eq[u128] { fn eq(a, b) = u128_eq(a, b); fn ne(a, b) = u128_ne(a, b); }
impl Eq[usize] { fn eq(a, b) = usize_eq(a, b); fn ne(a, b) = usize_ne(a, b); }
impl Eq[f32] { fn eq(a, b) = f32_eq(a, b); fn ne(a, b) = f32_ne(a, b); }
impl Eq[f64] { fn eq(a, b) = f64_eq(a, b); fn ne(a, b) = f64_ne(a, b); }

pub fn a == b = eq(a, b);

pub fn a != b = ne(a, b);

#[repr(i8)]
pub enum Ordering {
  Less = -1,
  Equal = 0,
  Greater = 1,
}

impl Eq[Ordering] {
  fn eq(a, b) = match (a, b) {
    (Ordering.Less, Ordering.Less)
    | (Ordering.Equal, Ordering.Equal)
    | (Ordering.Greater, Ordering.Greater) => True,
    _ => False,
  };
}

pub class Ord[T] {
  fn cmp(a: T, b: T) -> Ordering;
}

pub class PartialOrd[T] {
  fn partial_cmp(a: T, b: T) -> Option[Ordering];
}

/// The ordering of two values, from whether the first is less than or
/// greater than the second.
fn ordering(lt: Bool, gt: Bool) -> Ordering =
  if lt { Ordering.Less } else if gt { Ordering.Greater } else { Ordering.Equal };

// All values of these types are ordered, so their `partial_cmp` is always
// `Some` of their `cmp`, as in Rust.

impl Ord[Bool] { fn cmp(a, b) = ordering(bool_lt(a, b), bool_gt(a, b)); }
impl Ord[i8] { fn cmp(a, b) = ordering(i8_lt(a, b), i8_gt(a, b)); }
impl Ord[i16] { fn cmp(a, b) = ordering(i16_lt(a, b), i16_gt(a, b)); }
impl Ord[i32] { fn cmp(a, b) = ordering(i32_lt(a, b), i32_gt(a, b)); }
impl Ord[i64] { fn cmp(a, b) = ordering(i64_lt(a, b), i64_gt(a, b)); }
impl Ord[i128] { fn cmp(a, b) = ordering(i128_lt(a, b), i128_gt(a, b)); }
impl Ord[isize] { fn cmp(a, b) = ordering(isize_lt(a, b), isize_gt(a, b)); }
impl Ord[u8] { fn cmp(a, b) = ordering(u8_lt(a, b), u8_gt(a, b)); }
impl Ord[u16] { fn cmp(a, b) = ordering(u16_lt(a, b), u16_gt(a, b)); }
impl Ord[u32] { fn cmp(a, b) = ordering(u32_lt(a, b), u32_gt(a, b)); }
impl Ord[u64] { fn cmp(a, b) = ordering(u64_lt(a, b), u64_gt(a, b)); }
impl Ord[u128] { fn cmp(a, b) = ordering(u128_lt(a, b), u128_gt(a, b)); }
impl Ord[usize] { fn cmp(a, b) = ordering(usize_lt(a, b), usize_gt(a, b)); }

impl PartialOrd[Bool] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[i8] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[i16] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[i32] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[i64] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[i128] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[isize] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[u8] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[u16] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[u32] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[u64] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[u128] { fn partial_cmp(a, b) = Some(cmp(a, b)); }
impl PartialOrd[usize] { fn partial_cmp(a, b) = Some(cmp(a, b)); }

// Floats have no `Ord`: NaN is neither less than, equal to nor greater
// than any float, so comparing with it gives `None`.

/// The ordering of two floats, or `None` when one of them is NaN.
fn float_ordering(lt: Bool, gt: Bool, eq: Bool) -> Option[Ordering] =
  if lt || gt || eq { Some(ordering(lt, gt)) } else { None };

impl PartialOrd[f32] { fn partial_cmp(a, b) = float_ordering(f32_lt(a, b), f32_gt(a, b), f32_eq(a, b)); }
impl PartialOrd[f64] { fn partial_cmp(a, b) = float_ordering(f64_lt(a, b), f64_gt(a, b), f64_eq(a, b)); }

/// Types whose values can be ordered, with `a < b`.
pub class Lt[T] {
  fn lt(a: T, b: T) -> Bool;
}

impl[T] Lt[T] where PartialOrd[T] {
  fn lt(a, b) = partial_cmp(a, b) == Some(Ordering.Less);
}

pub fn a < b = lt(a, b);

/// Types whose values can be ordered, with `a > b`.
pub class Gt[T] {
  fn gt(a: T, b: T) -> Bool;
}

impl[T] Gt[T] where PartialOrd[T] {
  fn gt(a, b) = partial_cmp(a, b) == Some(Ordering.Greater);
}

pub fn a > b = gt(a, b);

/// Types whose values can be ordered, with `a <= b`.
pub class LtE[T] {
  fn lte(a: T, b: T) -> Bool;
}

impl[T] LtE[T] where PartialOrd[T] {
  fn lte(a, b) = match partial_cmp(a, b) {
    Some(Ordering.Less) | Some(Ordering.Equal) => True,
    _ => False,
  };
}

pub fn a <= b = lte(a, b);

/// Types whose values can be ordered, with `a >= b`.
pub class GtE[T] {
  fn gte(a: T, b: T) -> Bool;
}

impl[T] GtE[T] where PartialOrd[T] {
  fn gte(a, b) = match partial_cmp(a, b) {
    Some(Ordering.Greater) | Some(Ordering.Equal) => True,
    _ => False,
  };
}

pub fn a >= b = gte(a, b);

// The classes of operators, like Rust's `std::ops`. Each operator is a
// function of its class's method, so that it works on any type with an
// impl of the class. The primitive types have theirs, which are the
// builtins of `prim.bolt`.

/// Addition: `a + b`.
pub class Add[T] {
  /// The type of the result.
  type Output = T;

  fn add(a: T, b: T) -> Output;
}

impl Add[i8] { fn add(a, b) = i8_add(a, b); }
impl Add[i16] { fn add(a, b) = i16_add(a, b); }
impl Add[i32] { fn add(a, b) = i32_add(a, b); }
impl Add[i64] { fn add(a, b) = i64_add(a, b); }
impl Add[i128] { fn add(a, b) = i128_add(a, b); }
impl Add[isize] { fn add(a, b) = isize_add(a, b); }
impl Add[u8] { fn add(a, b) = u8_add(a, b); }
impl Add[u16] { fn add(a, b) = u16_add(a, b); }
impl Add[u32] { fn add(a, b) = u32_add(a, b); }
impl Add[u64] { fn add(a, b) = u64_add(a, b); }
impl Add[u128] { fn add(a, b) = u128_add(a, b); }
impl Add[usize] { fn add(a, b) = usize_add(a, b); }
impl Add[f32] { fn add(a, b) = f32_add(a, b); }
impl Add[f64] { fn add(a, b) = f64_add(a, b); }

pub fn a + b = add(a, b);

