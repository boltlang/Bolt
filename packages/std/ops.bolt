impl Shl[i8] { fn shl(a, n) = i8_shl(a, n); }
impl Shl[i16] { fn shl(a, n) = i16_shl(a, n); }
impl Shl[i32] { fn shl(a, n) = i32_shl(a, n); }
impl Shl[i64] { fn shl(a, n) = i64_shl(a, n); }
impl Shl[i128] { fn shl(a, n) = i128_shl(a, n); }
impl Shl[isize] { fn shl(a, n) = isize_shl(a, n); }
impl Shl[u8] { fn shl(a, n) = u8_shl(a, n); }
impl Shl[u16] { fn shl(a, n) = u16_shl(a, n); }
impl Shl[u32] { fn shl(a, n) = u32_shl(a, n); }
impl Shl[u64] { fn shl(a, n) = u64_shl(a, n); }
impl Shl[u128] { fn shl(a, n) = u128_shl(a, n); }
impl Shl[usize] { fn shl(a, n) = usize_shl(a, n); }

pub fn a << n = shl(a, n);

