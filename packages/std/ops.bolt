// Classes that syntax uses: `v[i]`, `v[i] = x` and `for x in c` work on any
// type with an impl of them. Arrays have theirs in `array.bolt`.

import "./option" (Option, None, Some);
import "./prim" *;
import "./mutability" (ToImmDeep);

/// Types whose elements can be read by position, with `c[i]`.
pub class Index[C] {
  /// The type of the elements.
  type Item;

  /// The element at `i`, for `c[i]`.
  fn index(c: C, i: i32) -> Item;
}

/// Types whose elements can be replaced by position, with `c[i] = x`.
pub class IndexMut[C] where Index[C] {
  /// Replace the element at `i` with `x`, for `c[i] = x`.
  fn set_index(c: C, i: i32, x: C.Item);
}

/// Types whose values can be compared, with `a == b` and `a != b`.
pub class Eq[T] {
  fn eq(a: ro T, b: ro T) -> Bool;
  fn ne(a: ro T, b: ro T) -> Bool = !eq(a, b);
}

impl Eq[Bool] { fn eq(a, b) = bool_eq(a, b); fn ne(a, b) = bool_ne(a, b); }
impl Eq[i8] { fn eq(a, b) = i8_eq(a, b); fn ne(a, b) = i8_ne(a, b); }
impl Eq[i16] { fn eq(a, b) = i16_eq(a, b); fn ne(a, b) = i16_ne(a, b); }
impl Eq[i32] { fn eq(a, b) = i32_eq(a, b); fn ne(a, b) = i32_ne(a, b); }
impl Eq[i64] { fn eq(a, b) = i64_eq(a, b); fn ne(a, b) = i64_ne(a, b); }
impl Eq[i128] { fn eq(a, b) = i128_eq(a, b); fn ne(a, b) = i128_ne(a, b); }
impl Eq[isize] { fn eq(a, b) = isize_eq(a, b); fn ne(a, b) = isize_ne(a, b); }
impl Eq[u8] { fn eq(a, b) = u8_eq(a, b); fn ne(a, b) = u8_ne(a, b); }
impl Eq[u16] { fn eq(a, b) = u16_eq(a, b); fn ne(a, b) = u16_ne(a, b); }
impl Eq[u32] { fn eq(a, b) = u32_eq(a, b); fn ne(a, b) = u32_ne(a, b); }
impl Eq[u64] { fn eq(a, b) = u64_eq(a, b); fn ne(a, b) = u64_ne(a, b); }
impl Eq[u128] { fn eq(a, b) = u128_eq(a, b); fn ne(a, b) = u128_ne(a, b); }
impl Eq[usize] { fn eq(a, b) = usize_eq(a, b); fn ne(a, b) = usize_ne(a, b); }
impl Eq[f32] { fn eq(a, b) = f32_eq(a, b); fn ne(a, b) = f32_ne(a, b); }
impl Eq[f64] { fn eq(a, b) = f64_eq(a, b); fn ne(a, b) = f64_ne(a, b); }

pub fn a == b = eq(a, b);

pub fn a != b = ne(a, b);

#[repr(i8)]
pub enum Ordering {
  Less = -1,
  Equal = 0,
  Greater = 1,
}

/// An `Ordering` never changes, so its deep copy is itself.
impl ToImmDeep[Ordering] { fn to_imm_deep(o) = o; }

impl Eq[Ordering] {
  fn eq(a, b) = match (a, b) {
    (Ordering.Less, Ordering.Less)
    | (Ordering.Equal, Ordering.Equal)
    | (Ordering.Greater, Ordering.Greater) => True,
    _ => False,
  };
}

pub class Ord[T] {
  fn cmp(a: ro T, b: ro T) -> Ordering;
}

/// Types whose values can be ordered, with `a < b`, `a > b`, `a <= b` and
/// `a >= b`. Two values may have no order, like NaN and a float, which
/// `partial_cmp` gives as `None`: then all four are `False`. An impl only
/// needs `partial_cmp`; the primitive types define the others too, with
/// their builtins.
pub class PartialOrd[T] {
  fn partial_cmp(a: ro T, b: ro T) -> Option[Ordering];
  fn lt(a: ro T, b: ro T) -> Bool = partial_cmp(a, b) == Some(Ordering.Less);
  fn gt(a: ro T, b: ro T) -> Bool = partial_cmp(a, b) == Some(Ordering.Greater);
  fn lte(a: ro T, b: ro T) -> Bool = match partial_cmp(a, b) {
    Some(Ordering.Less) | Some(Ordering.Equal) => True,
    _ => False,
  };
  fn gte(a: ro T, b: ro T) -> Bool = match partial_cmp(a, b) {
    Some(Ordering.Greater) | Some(Ordering.Equal) => True,
    _ => False,
  };
}

/// The ordering of two values, from whether the first is less than or
/// greater than the second.
fn ordering(lt: Bool, gt: Bool) -> Ordering =
  if lt { Ordering.Less } else if gt { Ordering.Greater } else { Ordering.Equal };

// All values of these types are ordered, so their `partial_cmp` is always
// `Some` of their `cmp`, as in Rust.

impl Ord[Bool] { fn cmp(a, b) = ordering(bool_lt(a, b), bool_gt(a, b)); }
impl Ord[i8] { fn cmp(a, b) = ordering(i8_lt(a, b), i8_gt(a, b)); }
impl Ord[i16] { fn cmp(a, b) = ordering(i16_lt(a, b), i16_gt(a, b)); }
impl Ord[i32] { fn cmp(a, b) = ordering(i32_lt(a, b), i32_gt(a, b)); }
impl Ord[i64] { fn cmp(a, b) = ordering(i64_lt(a, b), i64_gt(a, b)); }
impl Ord[i128] { fn cmp(a, b) = ordering(i128_lt(a, b), i128_gt(a, b)); }
impl Ord[isize] { fn cmp(a, b) = ordering(isize_lt(a, b), isize_gt(a, b)); }
impl Ord[u8] { fn cmp(a, b) = ordering(u8_lt(a, b), u8_gt(a, b)); }
impl Ord[u16] { fn cmp(a, b) = ordering(u16_lt(a, b), u16_gt(a, b)); }
impl Ord[u32] { fn cmp(a, b) = ordering(u32_lt(a, b), u32_gt(a, b)); }
impl Ord[u64] { fn cmp(a, b) = ordering(u64_lt(a, b), u64_gt(a, b)); }
impl Ord[u128] { fn cmp(a, b) = ordering(u128_lt(a, b), u128_gt(a, b)); }
impl Ord[usize] { fn cmp(a, b) = ordering(usize_lt(a, b), usize_gt(a, b)); }

impl PartialOrd[Bool] {
  fn partial_cmp(a, b) = Some(cmp(a, b));
  fn lt(a, b) = bool_lt(a, b);
  fn gt(a, b) = bool_gt(a, b);
  fn lte(a, b) = bool_le(a, b);
  fn gte(a, b) = bool_ge(a, b);
}
impl PartialOrd[i8] {
  fn partial_cmp(a, b) = Some(cmp(a, b));
  fn lt(a, b) = i8_lt(a, b);
  fn gt(a, b) = i8_gt(a, b);
  fn lte(a, b) = i8_le(a, b);
  fn gte(a, b) = i8_ge(a, b);
}
impl PartialOrd[i16] {
  fn partial_cmp(a, b) = Some(cmp(a, b));
  fn lt(a, b) = i16_lt(a, b);
  fn gt(a, b) = i16_gt(a, b);
  fn lte(a, b) = i16_le(a, b);
  fn gte(a, b) = i16_ge(a, b);
}
impl PartialOrd[i32] {
  fn partial_cmp(a, b) = Some(cmp(a, b));
  fn lt(a, b) = i32_lt(a, b);
  fn gt(a, b) = i32_gt(a, b);
  fn lte(a, b) = i32_le(a, b);
  fn gte(a, b) = i32_ge(a, b);
}
