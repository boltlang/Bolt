import "./string" (String, bytes);
import "./ops" *;
#[cfg(host = "wasm")]
import "./sys/wasi" (fd_write);
#[cfg(host = "emu")]
import "./sys/emu" (write);

/// Write `text` and a newline to stdout.
pub fn print(text: String) {
  write_line(1, text);
}

/// Write `text` and a newline to stderr.
pub fn eprint(text: String) {
  write_line(2, text);
}

/// Write `text` and a newline to the file `fd`, as its UTF-8 bytes. What
/// goes wrong is left out, since there's nowhere to say it.
#[cfg(host = "wasm")]
fn write_line(fd: u32, text: String) {
  fd_write(fd, [bytes(text), bytes("\n")]);
}

#[cfg(host = "emu")]
fn write_line(fd: i32, text: String) {
  write(fd, bytes(text));
  write(fd, bytes("\n"));
}

/// Stop the program with an error, at once.
#[builtin]
pub fn abort() -> !;

/// Stop the program with an error, after writing `message` to stderr.
pub fn panic(message: String) -> ! {
  eprint(message);
  abort()
}

/// Stop the program with an error unless `cond` holds. For tests: a test
/// fails when it stops with an error.
pub fn assert(cond: Bool) {
  if !cond {
    panic("assertion failed");
  }
}
