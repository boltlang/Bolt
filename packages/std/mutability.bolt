impl[
  A: ToMutDeep,
  B: ToMutDeep,
  C: ToMutDeep,
  D: ToMutDeep,
  E: ToMutDeep,
  F: ToMutDeep,
  G: ToMutDeep,
  H: ToMutDeep,
  I: ToMutDeep,
] ToMutDeep[(A, B, C, D, E, F, G, H, I)] {
  type MutDeep = mut (
    A.MutDeep,
    B.MutDeep,
    C.MutDeep,
    D.MutDeep,
    E.MutDeep,
    F.MutDeep,
    G.MutDeep,
    H.MutDeep,
    I.MutDeep,
  );
