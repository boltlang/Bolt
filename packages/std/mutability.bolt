  B: ToImmDeep,
  C: ToImmDeep,
  D: ToImmDeep,
  E: ToImmDeep,
  F: ToImmDeep,
  G: ToImmDeep,
  H: ToImmDeep,
  I: ToImmDeep,
  J: ToImmDeep,
] ToImmDeep[(A, B, C, D, E, F, G, H, I, J)] {
  fn to_imm_deep(t) = match t {
    (a, b, c, d, e, f, g, h, i, j) => (
      to_imm_deep(a),
      to_imm_deep(b),
      to_imm_deep(c),
      to_imm_deep(d),
      to_imm_deep(e),
      to_imm_deep(f),
      to_imm_deep(g),
      to_imm_deep(h),
      to_imm_deep(i),
      to_imm_deep(j),
    ),
  };
}
