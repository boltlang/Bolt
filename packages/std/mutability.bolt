/// Types that have a copy that can't be changed all the way down, even if
/// the original can: the arrays and structs it holds are copied too, not
/// shared as with [ToImm], so it can hold what's `mut`.
///
/// Each path to an object gets its own copy, so two references to one
/// `mut` object become two `imm` objects, and a cycle is copied forever. A
/// type whose values can be cyclic says what its copy does with its own
/// impl.
///
/// Values that are `imm` all the way down, like numbers, `String` and
/// `Char`, are given back as they are: they have nothing to copy.
pub class ToImmDeep[T] {
  /// A copy of `x` that can't be changed all the way down, like an `imm
  /// [imm [i32]]` for a `[[i32]]`.
  fn to_imm_deep(x: T) -> imm T;
}

impl ToImmDeep[Bool] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i8] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i16] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[i128] { fn to_imm_deep(x) = x; }
impl ToImmDeep[isize] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u8] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u16] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[u128] { fn to_imm_deep(x) = x; }
impl ToImmDeep[usize] { fn to_imm_deep(x) = x; }
impl ToImmDeep[f32] { fn to_imm_deep(x) = x; }
impl ToImmDeep[f64] { fn to_imm_deep(x) = x; }
impl ToImmDeep[()] { fn to_imm_deep(x) = x; }

/// A tuple is copied element by element, into a `mut` tuple. There are
/// impls up to ten elements: one for every length needs #363.
impl[A: ToImmDeep, B: ToImmDeep] ToImmDeep[(A, B)] {
  fn to_imm_deep(p) = match p { (a, b) => (to_imm_deep(a), to_imm_deep(b)) };
}

impl[A: ToImmDeep, B: ToImmDeep, C: ToImmDeep] ToImmDeep[(A, B, C)] {
  fn to_imm_deep(t) = match t {
    (a, b, c) => (to_imm_deep(a), to_imm_deep(b), to_imm_deep(c)),
  };
}

impl[A: ToImmDeep, B: ToImmDeep, C: ToImmDeep, D: ToImmDeep] ToImmDeep[(A, B, C, D)] {
  fn to_imm_deep(t) = match t {
    (a, b, c, d) => (to_imm_deep(a), to_imm_deep(b), to_imm_deep(c), to_imm_deep(d)),
  };
}

impl[
  A: ToImmDeep,
  B: ToImmDeep,
  C: ToImmDeep,
  D: ToImmDeep,
  E: ToImmDeep,
] ToImmDeep[(A, B, C, D, E)] {
  fn to_imm_deep(t) = match t {
    (a, b, c, d, e) => (
      to_imm_deep(a),
      to_imm_deep(b),
      to_imm_deep(c),
      to_imm_deep(d),
      to_imm_deep(e),
    ),
  };
}

impl[
  A: ToImmDeep,
  B: ToImmDeep,
  C: ToImmDeep,
  D: ToImmDeep,
  E: ToImmDeep,
  F: ToImmDeep,
] ToImmDeep[(A, B, C, D, E, F)] {
  fn to_imm_deep(t) = match t {
    (a, b, c, d, e, f) => (
      to_imm_deep(a),
      to_imm_deep(b),
      to_imm_deep(c),
      to_imm_deep(d),
      to_imm_deep(e),
      to_imm_deep(f),
