import "./option" (Option, Some, None);

/// Types that give their items one at a time, until there are none left.
pub class Iterator[I] {
  /// The type of the items.
  type Item;

  /// The next item, or `None` when there are no more.
  fn next(it: I) -> Option[Item];
}

/// Types that can produce an [Iterator].
///
/// These types can be looped over with `for x in c`.
pub class Iterable[C] {

  /// The elements the fresh iterator produces.
  type Item = Iter.Item;

  /// The iterator that goes over the collection `C`.
  type Iter: Iterator[Item = Item];

  /// Produce a new iterator over `c`.
  fn iter(c: C) -> Iter;

}

/// An iterator that iterates over two other iterators in parallel.
pub struct ZipIter[A: Iterator, B: Iterator] {
  first: A,
  second: B,
}

impl[A: Iterator, B: Iterator] Iterator[ZipIter[A, B]] {

  type Item = mut (A.Item, B.Item);

  fn next(it) {
    match mut (it.first.next(), it.second.next()) {
      (Some(a), Some(b)) => Some(mut (a, b)),
      _ => None,
    }
  }

}

pub struct Zipper[A: Iterable, B: Iterable] {
  first: A,
  second: B,
}

impl[A: Iterable, B: Iterable] Iterable[Zipper[A, B]] {

  type Iter = mut ZipIter[A.Iter, B.Iter];

  fn iter(self) = mut ZipIter { first: iter(self.first), second: iter(self.second) };

}

pub fn zip[A: Iterable, B: Iterable](first: A, second: B) -> mut Zipper[A, B] {
  mut Zipper { first, second }
}
