// The tests of `array.bolt`.

import "./array" *;
import "./mutability" (to_mut, to_imm);
import "./ops" *;
import "./io" (assert);

#[test]
fn a_copy_of_an_array_that_can_be_changed() {
  let xs = [1, 2, 3];
  let ys = to_mut(xs);
  ys[0] = 10;
  assert(xs == [1, 2, 3]);
  assert(ys == mut [10, 2, 3]);
}

#[test]
fn a_copy_of_an_array_that_can_t_be_changed() {
  let xs = mut [1, 2];
  let frozen = to_imm(xs);
  xs[0] = 10;
  assert(xs == mut [10, 2]);
  assert(frozen == [1, 2]);
}

struct TestPoint { x: i32 }

#[test]
fn copies_of_arrays_are_shallow() {
  let points = mut [mut TestPoint { x: 1 }];
  let copy = to_mut(points);
  copy[0].x = 5;
  assert(points[0].x == 5);
}

#[test]
fn arrays_are_equal_when_their_elements_are() {
  assert([1, 2, 3] == [1, 2, 3]);
  assert([1, 2, 3] != [1, 2, 4]);
  assert([1, 2] != [1, 2, 3]);
}

#[test]
fn array_len_counts_the_elements() {
  let xs = mut [1, 2];
  let n = array_len(xs);
  xs[0] = 3;
  assert(n == 2);
  assert(array_len([True]) == 1);
  assert(array_len([]) == 0);
}

#[test]
fn array_copy_copies_ranges() {
  let a = mut [1, 2, 3, 4, 5];
  let b = mut [0, 0, 0];
  array_copy(b, 1, a, 3, 2);
  assert(b == mut [0, 4, 5]);
}

#[test]
fn array_copy_copies_within_one_array() {
  // To the right, and to the left; the ranges overlap.
  let c = mut [1, 2, 3, 4, 5];
  array_copy(c, 1, c, 0, 3);
  assert(c == mut [1, 1, 2, 3, 5]);
  let d = mut [1, 2, 3, 4, 5];
  array_copy(d, 0, d, 2, 3);
  assert(d == mut [3, 4, 5, 4, 5]);
  // Copying nothing, at the end, changes nothing.
  array_copy(d, 5, d, 0, 0);
  assert(d == mut [3, 4, 5, 4, 5]);
}
