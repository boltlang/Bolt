import "./io" (panic, assert);
import "./ops" *;

pub enum Option[T] {
  None,
  Some(T),
}

pub import Option.*;

/// Options are equal when both are `None`, or both are `Some` of equal
/// values.
impl[T] Eq[Option[T]] where Eq[T] {
  fn eq(a, b) = match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => True,
    _ => False,
  };
}

pub fn unwrap[T](x: Option[T]) = match x {
  None => panic("trying to unwrap a None-valued option"), // TODO print T in the panic message
  Some(x) => x
};

// Tests

fn test_safe_div(a: i32, b: i32) -> Option[i32] = if b == 0 { None } else { Some(a / b) };

#[test]
fn some_and_none() {
  assert(test_safe_div(7, 2) == Some(3));
  assert(test_safe_div(7, 0) == None);
  assert(match test_safe_div(7, 2) { Some(n) => n, None => -1 } == 3);
}

#[test]
fn unwrapping_some() {
  assert(unwrap(Some(1)) == 1);
}
