import "./io" (panic, assert);
import "./ops" *;
import "./mutability" (ToImmDeep, to_imm_deep);

pub enum Option[T] {
  None,
  Some(T),
}

pub import Option.*;

/// A copy of an `Option` that can't be changed all the way down: what it
/// holds is copied with its own `to_imm_deep`.
impl[T: ToImmDeep] ToImmDeep[Option[T]] {
  fn to_imm_deep(o) = match o {
    None => None,
    Some(x) => Some(to_imm_deep(x)),
  };
}

/// Options are equal when both are `None`, or both are `Some` of equal
/// values.
impl[T] Eq[Option[T]] where Eq[T] {
  fn eq(a, b) = match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => True,
    _ => False,
  };
}

pub fn unwrap[T](x: Option[T]) = match x {
  None => panic("trying to unwrap a None-valued option"), // TODO print T in the panic message
  Some(x) => x
};
