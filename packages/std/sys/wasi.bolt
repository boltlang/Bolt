// WASI preview 1, the module `wasi_snapshot_preview1`, which hosts like
// Wasmtime, Node and browsers' shims provide. Each function is the host's,
// with WASI's types: its enums are Bolt enums, passed as their index, its
// integer types are aliases, and its flags are constants. What WASI gives
// back through pointers is the rest of a tuple, after the `Errno`, and its
// structs are Bolt structs, which the functions that take or give them
// encode to or decode from WASI's layout.
//
// They're for `std` to build its I/O on, so they're `pub(package)`.

import "../ops" *;
import "../array" (array_len, array_alloc, array_set, array_freeze);

pub(package) type Size = u32;
pub(package) type Filesize = u64;
pub(package) type Timestamp = u64;
pub(package) type Fd = u32;
pub(package) type Filedelta = i64;
pub(package) type Dircookie = u64;
pub(package) type Dirnamlen = u32;
pub(package) type Inode = u64;
pub(package) type Device = u64;
pub(package) type Linkcount = u64;
pub(package) type Userdata = u64;
pub(package) type Exitcode = u32;

/// What went wrong, as `errno.h` says it, or `Success`.
pub(package) enum Errno {
  Success,
  TooBig,
  Acces,
  Addrinuse,
  Addrnotavail,
  Afnosupport,
  Again,
  Already,
  Badf,
  Badmsg,
  Busy,
  Canceled,
  Child,
  Connaborted,
  Connrefused,
  Connreset,
  Deadlk,
  Destaddrreq,
  Dom,
  Dquot,
  Exist,
  Fault,
  Fbig,
  Hostunreach,
  Idrm,
  Ilseq,
  Inprogress,
  Intr,
  Inval,
  Io,
  Isconn,
  Isdir,
  Loop,
  Mfile,
  Mlink,
  Msgsize,
  Multihop,
  Nametoolong,
  Netdown,
  Netreset,
  Netunreach,
  Nfile,
  Nobufs,
  Nodev,
  Noent,
  Noexec,
  Nolck,
  Nolink,
  Nomem,
  Nomsg,
  Noprotoopt,
  Nospc,
  Nosys,
  Notconn,
  Notdir,
  Notempty,
  Notrecoverable,
  Notsock,
  Notsup,
  Notty,
  Nxio,
  Overflow,
  Ownerdead,
  Perm,
  Pipe,
  Proto,
  Protonosupport,
  Prototype,
  Range,
  Rofs,
  Spipe,
  Srch,
  Stale,
  Timedout,
  Txtbsy,
  Xdev,
  Notcapable,
}

/// Which clock to read.
pub(package) enum Clockid { Realtime, Monotonic, ProcessCputimeId, ThreadCputimeId }

/// Where `fd_seek` counts from.
pub(package) enum Whence { Set, Cur, End }

/// What a file is.
pub(package) enum Filetype {
  Unknown,
  BlockDevice,
  CharacterDevice,
  Directory,
  RegularFile,
  SocketDgram,
  SocketStream,
  SymbolicLink,
}

/// How a file will be read, for `fd_advise`.
pub(package) enum Advice { Normal, Sequential, Random, Willneed, Dontneed, Noreuse }

/// What a subscription of `poll_oneoff` waits for.
pub(package) enum Eventtype { Clock, FdRead, FdWrite }

/// A signal, for `proc_raise`.
pub(package) enum Signal {
  None,
  Hup,
  Int,
  Quit,
  Ill,
  Trap,
  Abrt,
  Bus,
  Fpe,
  Kill,
  Usr1,
  Segv,
  Usr2,
  Pipe,
  Alrm,
  Term,
  Chld,
  Cont,
  Stop,
  Tstp,
  Ttin,
  Ttou,
  Urg,
  Xcpu,
  Xfsz,
  Vtalrm,
  Prof,
  Winch,
  Poll,
  Pwr,
  Sys,
}

/// What a preopened file descriptor is.
pub(package) enum Preopentype { Dir }

/// What a file descriptor may do: a set of the `RIGHT_` flags.
pub(package) type Rights = u64;
pub(package) const RIGHT_FD_DATASYNC: Rights = 1;
pub(package) const RIGHT_FD_READ: Rights = 2;
pub(package) const RIGHT_FD_SEEK: Rights = 4;
pub(package) const RIGHT_FD_FDSTAT_SET_FLAGS: Rights = 8;
pub(package) const RIGHT_FD_SYNC: Rights = 16;
pub(package) const RIGHT_FD_TELL: Rights = 32;
pub(package) const RIGHT_FD_WRITE: Rights = 64;
pub(package) const RIGHT_FD_ADVISE: Rights = 128;
pub(package) const RIGHT_FD_ALLOCATE: Rights = 256;
pub(package) const RIGHT_PATH_CREATE_DIRECTORY: Rights = 512;
pub(package) const RIGHT_PATH_CREATE_FILE: Rights = 1024;
pub(package) const RIGHT_PATH_LINK_SOURCE: Rights = 2048;
pub(package) const RIGHT_PATH_LINK_TARGET: Rights = 4096;
pub(package) const RIGHT_PATH_OPEN: Rights = 8192;
pub(package) const RIGHT_FD_READDIR: Rights = 16384;
pub(package) const RIGHT_PATH_READLINK: Rights = 32768;
pub(package) const RIGHT_PATH_RENAME_SOURCE: Rights = 65536;
pub(package) const RIGHT_PATH_RENAME_TARGET: Rights = 131072;
pub(package) const RIGHT_PATH_FILESTAT_GET: Rights = 262144;
pub(package) const RIGHT_PATH_FILESTAT_SET_SIZE: Rights = 524288;
pub(package) const RIGHT_PATH_FILESTAT_SET_TIMES: Rights = 1048576;
pub(package) const RIGHT_FD_FILESTAT_GET: Rights = 2097152;
pub(package) const RIGHT_FD_FILESTAT_SET_SIZE: Rights = 4194304;
pub(package) const RIGHT_FD_FILESTAT_SET_TIMES: Rights = 8388608;
pub(package) const RIGHT_PATH_SYMLINK: Rights = 16777216;
pub(package) const RIGHT_PATH_REMOVE_DIRECTORY: Rights = 33554432;
pub(package) const RIGHT_PATH_UNLINK_FILE: Rights = 67108864;
pub(package) const RIGHT_POLL_FD_READWRITE: Rights = 134217728;
pub(package) const RIGHT_SOCK_SHUTDOWN: Rights = 268435456;
pub(package) const RIGHT_SOCK_ACCEPT: Rights = 536870912;

/// How a file descriptor reads and writes: a set of the `FDFLAG_` flags.
pub(package) type Fdflags = u16;
pub(package) const FDFLAG_APPEND: Fdflags = 1;
pub(package) const FDFLAG_DSYNC: Fdflags = 2;
pub(package) const FDFLAG_NONBLOCK: Fdflags = 4;
pub(package) const FDFLAG_RSYNC: Fdflags = 8;
pub(package) const FDFLAG_SYNC: Fdflags = 16;

/// Which times `fd_filestat_set_times` sets: a set of the `FSTFLAG_` flags.
pub(package) type Fstflags = u16;
pub(package) const FSTFLAG_ATIM: Fstflags = 1;
pub(package) const FSTFLAG_ATIM_NOW: Fstflags = 2;
pub(package) const FSTFLAG_MTIM: Fstflags = 4;
pub(package) const FSTFLAG_MTIM_NOW: Fstflags = 8;

/// How a path is looked up: a set of the `LOOKUPFLAG_` flags.
pub(package) type Lookupflags = u32;
pub(package) const LOOKUPFLAG_SYMLINK_FOLLOW: Lookupflags = 1;

/// How `path_open` opens a file: a set of the `OFLAG_` flags.
pub(package) type Oflags = u16;
pub(package) const OFLAG_CREAT: Oflags = 1;
pub(package) const OFLAG_DIRECTORY: Oflags = 2;
pub(package) const OFLAG_EXCL: Oflags = 4;
pub(package) const OFLAG_TRUNC: Oflags = 8;

/// What happened to a file descriptor that `poll_oneoff` waited for.
pub(package) type Eventrwflags = u16;
pub(package) const EVENTRWFLAG_FD_READWRITE_HANGUP: Eventrwflags = 1;

/// How a clock subscription's timeout counts.
pub(package) type Subclockflags = u16;
pub(package) const SUBCLOCKFLAG_SUBSCRIPTION_CLOCK_ABSTIME: Subclockflags = 1;

/// How `sock_recv` receives: a set of the `RIFLAG_` flags.
pub(package) type Riflags = u16;
pub(package) const RIFLAG_RECV_PEEK: Riflags = 1;
pub(package) const RIFLAG_RECV_WAITALL: Riflags = 2;

/// What `sock_recv` says about what it received.
pub(package) type Roflags = u16;
pub(package) const ROFLAG_RECV_DATA_TRUNCATED: Roflags = 1;

/// How `sock_send` sends: no flags yet.
pub(package) type Siflags = u16;

/// Which sides `sock_shutdown` shuts down.
pub(package) type Sdflags = u8;
pub(package) const SDFLAG_RD: Sdflags = 1;
pub(package) const SDFLAG_WR: Sdflags = 2;

/// What `fd_fdstat_get` says about a file descriptor.
pub(package) struct Fdstat {
  pub(package) filetype: Filetype,
  pub(package) flags: Fdflags,
  pub(package) rights_base: Rights,
  pub(package) rights_inheriting: Rights,
}

/// What `fd_filestat_get` and `path_filestat_get` say about a file.
pub(package) struct Filestat {
  pub(package) dev: Device,
  pub(package) ino: Inode,
  pub(package) filetype: Filetype,
  pub(package) nlink: Linkcount,
  pub(package) size: Filesize,
  pub(package) atim: Timestamp,
  pub(package) mtim: Timestamp,
  pub(package) ctim: Timestamp,
}

/// What `fd_prestat_get` says about a preopened file descriptor: a
/// directory, and the length of its name.
pub(package) struct Prestat {
  pub(package) kind: Preopentype,
  pub(package) name_len: Size,
}

/// An entry of a directory, as `fd_readdir` writes them, before its name.
pub(package) struct Dirent {
  pub(package) next: Dircookie,
  pub(package) ino: Inode,
  pub(package) namlen: Dirnamlen,
  pub(package) filetype: Filetype,
}

/// What `poll_oneoff` waits for, and its `userdata`.
pub(package) enum Subscription {
  Clock { userdata: Userdata, id: Clockid, timeout: Timestamp, precision: Timestamp, flags: Subclockflags },
  FdRead { userdata: Userdata, fd: Fd },
  FdWrite { userdata: Userdata, fd: Fd },
}

/// What happened to a subscription of `poll_oneoff`, by its `userdata`.
pub(package) struct Event {
  pub(package) userdata: Userdata,
  pub(package) error: Errno,
  pub(package) kind: Eventtype,
  pub(package) nbytes: Filesize,
  pub(package) flags: Eventrwflags,
}

/// The size of each struct in WASI's layout.
const FDSTAT_SIZE: i32 = 24;
const FILESTAT_SIZE: i32 = 64;
const PRESTAT_SIZE: i32 = 8;
pub(package) const DIRENT_SIZE: i32 = 24;
const SUBSCRIPTION_SIZE: i32 = 48;
const EVENT_SIZE: i32 = 32;

// The functions of the host.

/// Write the arguments to `buf`, each ending in a zero, and their
/// addresses to `argv`. `args_sizes_get` says how big each must be.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn args_get(#[addr] argv: mut [u32], #[addr] buf: mut [u8]) -> Errno;

/// How many arguments there are, and how many bytes they take.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn args_sizes_get() -> (Errno, Size, Size);

/// Write the environment variables to `buf` as `KEY=value`, each ending in
/// a zero, and their addresses to `environ`.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn environ_get(#[addr] environ: mut [u32], #[addr] buf: mut [u8]) -> Errno;

/// How many environment variables there are, and how many bytes they take.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn environ_sizes_get() -> (Errno, Size, Size);

/// The resolution of a clock.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn clock_res_get(id: Clockid) -> (Errno, Timestamp);

/// The time of a clock, in nanoseconds, to at least `precision`.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn clock_time_get(id: Clockid, precision: Timestamp) -> (Errno, Timestamp);

/// Say how a range of a file will be used.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_advise(fd: Fd, offset: Filesize, len: Filesize, advice: Advice) -> Errno;

/// Make sure the space of a range of a file is there.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_allocate(fd: Fd, offset: Filesize, len: Filesize) -> Errno;

/// Close a file descriptor.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_close(fd: Fd) -> Errno;

/// Write a file's data to its device.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_datasync(fd: Fd) -> Errno;

#[link(wasm, module = "wasi_snapshot_preview1", name = "fd_fdstat_get", abi = flat)]
fn fd_fdstat_get_bytes(fd: Fd, #[addr] stat: mut [u8]) -> Errno;

/// What a file descriptor is, and may do.
pub(package) fn fd_fdstat_get(fd: Fd) -> (Errno, Fdstat) {
  let buf = mut [0u8; FDSTAT_SIZE as usize];
  let e = fd_fdstat_get_bytes(fd, buf);
  let stat = Fdstat {
    filetype: filetype_of(buf[0]),
    flags: read_u16(buf, 2),
    rights_base: read_u64(buf, 8),
    rights_inheriting: read_u64(buf, 16),
  };
  (e, stat)
}

/// Set how a file descriptor reads and writes.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_fdstat_set_flags(fd: Fd, flags: Fdflags) -> Errno;

/// Take rights away from a file descriptor.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_fdstat_set_rights(fd: Fd, base: Rights, inheriting: Rights) -> Errno;

#[link(wasm, module = "wasi_snapshot_preview1", name = "fd_filestat_get", abi = flat)]
fn fd_filestat_get_bytes(fd: Fd, #[addr] stat: mut [u8]) -> Errno;

/// What an open file is.
pub(package) fn fd_filestat_get(fd: Fd) -> (Errno, Filestat) {
  let buf = mut [0u8; FILESTAT_SIZE as usize];
  let e = fd_filestat_get_bytes(fd, buf);
  (e, filestat_of(buf))
}

/// Make an open file this big, cutting it or adding zeros.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_filestat_set_size(fd: Fd, size: Filesize) -> Errno;

/// Set when an open file was last read and changed.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_filestat_set_times(fd: Fd, atim: Timestamp, mtim: Timestamp, flags: Fstflags) -> Errno;

/// Read into `iovs`, from `offset`, without moving the file's position:
/// how many bytes it read.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_pread(fd: Fd, iovs: [mut [u8]], offset: Filesize) -> (Errno, Size);

#[link(wasm, module = "wasi_snapshot_preview1", name = "fd_prestat_get", abi = flat)]
fn fd_prestat_get_bytes(fd: Fd, #[addr] stat: mut [u8]) -> Errno;

/// What a preopened file descriptor is: `Badf` once there are no more.
pub(package) fn fd_prestat_get(fd: Fd) -> (Errno, Prestat) {
  let buf = mut [0u8; PRESTAT_SIZE as usize];
  let e = fd_prestat_get_bytes(fd, buf);
  (e, Prestat { kind: Preopentype.Dir, name_len: read_u32(buf, 4) })
}

/// The name of a preopened directory, written to `path`.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_prestat_dir_name(fd: Fd, path: mut [u8]) -> Errno;

/// Write `iovs` at `offset`, without moving the file's position: how many
/// bytes it wrote.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_pwrite(fd: Fd, iovs: [[u8]], offset: Filesize) -> (Errno, Size);

/// Read into `iovs`: how many bytes it read, `0` at the end.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_read(fd: Fd, iovs: [mut [u8]]) -> (Errno, Size);

/// Write the entries of a directory to `buf`, from `cookie`, each a dirent
/// and then its name: how many bytes it wrote. Fewer than fit means the
/// end. `dirent_of` reads an entry.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_readdir(fd: Fd, buf: mut [u8], cookie: Dircookie) -> (Errno, Size);

/// Make `to` the file descriptor `fd` is, closing what `to` was.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_renumber(fd: Fd, to: Fd) -> Errno;

/// Move the file's position: the new one.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_seek(fd: Fd, offset: Filedelta, whence: Whence) -> (Errno, Filesize);

/// Write a file's data and what's known of it to its device.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_sync(fd: Fd) -> Errno;

/// The file's position.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_tell(fd: Fd) -> (Errno, Filesize);

/// Write `iovs`: how many bytes it wrote.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn fd_write(fd: Fd, iovs: [[u8]]) -> (Errno, Size);

/// Make a directory.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_create_directory(fd: Fd, path: [u8]) -> Errno;

#[link(wasm, module = "wasi_snapshot_preview1", name = "path_filestat_get", abi = flat)]
fn path_filestat_get_bytes(fd: Fd, flags: Lookupflags, path: [u8], #[addr] stat: mut [u8]) -> Errno;

/// What a file is, by its path.
pub(package) fn path_filestat_get(fd: Fd, flags: Lookupflags, path: [u8]) -> (Errno, Filestat) {
  let buf = mut [0u8; FILESTAT_SIZE as usize];
  let e = path_filestat_get_bytes(fd, flags, path, buf);
  (e, filestat_of(buf))
}

