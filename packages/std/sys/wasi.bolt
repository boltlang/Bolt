/// Write what a symbolic link points to to `buf`: how many bytes it wrote.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_readlink(fd: Fd, path: [u8], buf: mut [u8]) -> (Errno, Size);

/// Remove an empty directory.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_remove_directory(fd: Fd, path: [u8]) -> Errno;

/// Rename a file or directory.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_rename(fd: Fd, old_path: [u8], new_fd: Fd, new_path: [u8]) -> Errno;

/// Make a symbolic link at `new_path` to `old_path`.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_symlink(old_path: [u8], fd: Fd, new_path: [u8]) -> Errno;

/// Remove a file.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_unlink_file(fd: Fd, path: [u8]) -> Errno;

#[link(wasm, module = "wasi_snapshot_preview1", name = "poll_oneoff", abi = flat)]
fn poll_oneoff_bytes(#[addr] subs: [u8], #[addr] events: mut [u8], count: Size) -> (Errno, Size);

/// Wait until one of `subs` happens: the events that did.
pub(package) fn poll_oneoff(subs: [Subscription]) -> (Errno, [Event]) {
  let n = array_len(subs);
  let input = mut [0u8; (SUBSCRIPTION_SIZE * n) as usize];
  let mut i = 0;
  while i < n {
    write_subscription(input, i * SUBSCRIPTION_SIZE, subs[i]);
    i = i + 1;
  }
  let output = mut [0u8; (EVENT_SIZE * n) as usize];
  let r = poll_oneoff_bytes(input, output, n as u32);
  let count = r.1 as i32;
  let events = array_alloc(count);
  let mut j = 0;
  while j < count {
    array_set(events, j, event_of(output, j * EVENT_SIZE));
    j = j + 1;
  }
  (r.0, array_freeze(events))
}

