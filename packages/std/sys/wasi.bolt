/// Fill `buf` with random bytes.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn random_get(buf: mut [u8]) -> Errno;

/// Accept a connection on a socket: its file descriptor.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn sock_accept(fd: Fd, flags: Fdflags) -> (Errno, Fd);

/// Receive into `ri_data`: how many bytes it received, and what it says
/// about them.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn sock_recv(fd: Fd, ri_data: [mut [u8]], ri_flags: Riflags) -> (Errno, Size, Roflags);

/// Send `si_data`: how many bytes it sent.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn sock_send(fd: Fd, si_data: [[u8]], si_flags: Siflags) -> (Errno, Size);

/// Shut down a socket's sides.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn sock_shutdown(fd: Fd, how: Sdflags) -> Errno;

// WASI's layouts, little-endian.

fn read_u16(buf: [u8], at: i32) -> u16 = (buf[at] as u16) | ((buf[at + 1] as u16) << 8);

fn read_u32(buf: [u8], at: i32) -> u32 {
  let mut n: u32 = 0;
  let mut i = 3;
  while i >= 0 {
    n = (n << 8) | (buf[at + i] as u32);
    i = i - 1;
  }
  n
}

fn read_u64(buf: [u8], at: i32) -> u64 {
  let mut n: u64 = 0;
  let mut i = 7;
  while i >= 0 {
    n = (n << 8) | (buf[at + i] as u64);
    i = i - 1;
  }
  n
}

fn write_u16(buf: mut [u8], at: i32, n: u16) {
  buf[at] = n as u8;
  buf[at + 1] = (n >> 8) as u8;
}

fn write_u32(buf: mut [u8], at: i32, n: u32) {
  let mut i = 0;
  while i < 4 {
    buf[at + i] = (n >> (8 * i as u32)) as u8;
    i = i + 1;
  }
}

fn write_u64(buf: mut [u8], at: i32, n: u64) {
  let mut i = 0;
  while i < 8 {
    buf[at + i] = (n >> (8 * i as u32)) as u8;
    i = i + 1;
  }
}

fn filetype_of(n: u8) -> Filetype = match n {
  1 => Filetype.BlockDevice,
  2 => Filetype.CharacterDevice,
  3 => Filetype.Directory,
  4 => Filetype.RegularFile,
  5 => Filetype.SocketDgram,
  6 => Filetype.SocketStream,
  7 => Filetype.SymbolicLink,
  _ => Filetype.Unknown,
};

fn eventtype_of(n: u8) -> Eventtype = match n {
  1 => Eventtype.FdRead,
  2 => Eventtype.FdWrite,
  _ => Eventtype.Clock,
};

fn filestat_of(buf: [u8]) -> Filestat = Filestat {
  dev: read_u64(buf, 0),
  ino: read_u64(buf, 8),
  filetype: filetype_of(buf[16]),
  nlink: read_u64(buf, 24),
  size: read_u64(buf, 32),
  atim: read_u64(buf, 40),
  mtim: read_u64(buf, 48),
  ctim: read_u64(buf, 56),
};

/// The entry of a directory at `at` in what `fd_readdir` wrote. Its name
/// is the `namlen` bytes after it, at `at + DIRENT_SIZE`.
pub(package) fn dirent_of(buf: [u8], at: i32) -> Dirent = Dirent {
  next: read_u64(buf, at),
  ino: read_u64(buf, at + 8),
  namlen: read_u32(buf, at + 16),
  filetype: filetype_of(buf[at + 20]),
};

fn event_of(buf: [u8], at: i32) -> Event = Event {
  userdata: read_u64(buf, at),
  error: errno_of(read_u16(buf, at + 8)),
  kind: eventtype_of(buf[at + 10]),
  nbytes: read_u64(buf, at + 16),
  flags: read_u16(buf, at + 24),
};

fn write_subscription(buf: mut [u8], at: i32, sub: Subscription) {
  match sub {
    Subscription.Clock { userdata, id, timeout, precision, flags } => {
      write_u64(buf, at, userdata);
      buf[at + 8] = 0u8;
      write_u32(buf, at + 16, clockid_code(id));
      write_u64(buf, at + 24, timeout);
      write_u64(buf, at + 32, precision);
      write_u16(buf, at + 40, flags);
    }
    Subscription.FdRead { userdata, fd } => {
      write_u64(buf, at, userdata);
      buf[at + 8] = 1u8;
      write_u32(buf, at + 16, fd);
    }
    Subscription.FdWrite { userdata, fd } => {
      write_u64(buf, at, userdata);
      buf[at + 8] = 2u8;
      write_u32(buf, at + 16, fd);
    }
  }
}

fn clockid_code(id: Clockid) -> u32 = match id {
  Clockid.Realtime => 0,
  Clockid.Monotonic => 1,
  Clockid.ProcessCputimeId => 2,
  Clockid.ThreadCputimeId => 3,
};

/// The `Errno` with the code `n`, which a host gives in an event.
fn errno_of(n: u16) -> Errno = match n {
  0 => Errno.Success, 1 => Errno.TooBig, 2 => Errno.Acces, 3 => Errno.Addrinuse,
  4 => Errno.Addrnotavail, 5 => Errno.Afnosupport, 6 => Errno.Again, 7 => Errno.Already,
  8 => Errno.Badf, 9 => Errno.Badmsg, 10 => Errno.Busy, 11 => Errno.Canceled,
  12 => Errno.Child, 13 => Errno.Connaborted, 14 => Errno.Connrefused, 15 => Errno.Connreset,
  16 => Errno.Deadlk, 17 => Errno.Destaddrreq, 18 => Errno.Dom, 19 => Errno.Dquot,
  20 => Errno.Exist, 21 => Errno.Fault, 22 => Errno.Fbig, 23 => Errno.Hostunreach,
  24 => Errno.Idrm, 25 => Errno.Ilseq, 26 => Errno.Inprogress, 27 => Errno.Intr,
  28 => Errno.Inval, 29 => Errno.Io, 30 => Errno.Isconn, 31 => Errno.Isdir,
  32 => Errno.Loop, 33 => Errno.Mfile, 34 => Errno.Mlink, 35 => Errno.Msgsize,
  36 => Errno.Multihop, 37 => Errno.Nametoolong, 38 => Errno.Netdown, 39 => Errno.Netreset,
  40 => Errno.Netunreach, 41 => Errno.Nfile, 42 => Errno.Nobufs, 43 => Errno.Nodev,
  44 => Errno.Noent, 45 => Errno.Noexec, 46 => Errno.Nolck, 47 => Errno.Nolink,
  48 => Errno.Nomem, 49 => Errno.Nomsg, 50 => Errno.Noprotoopt, 51 => Errno.Nospc,
  52 => Errno.Nosys, 53 => Errno.Notconn, 54 => Errno.Notdir, 55 => Errno.Notempty,
  56 => Errno.Notrecoverable, 57 => Errno.Notsock, 58 => Errno.Notsup, 59 => Errno.Notty,
  60 => Errno.Nxio, 61 => Errno.Overflow, 62 => Errno.Ownerdead, 63 => Errno.Perm,
  64 => Errno.Pipe, 65 => Errno.Proto, 66 => Errno.Protonosupport, 67 => Errno.Prototype,
  68 => Errno.Range, 69 => Errno.Rofs, 70 => Errno.Spipe, 71 => Errno.Srch,
  72 => Errno.Stale, 73 => Errno.Timedout, 74 => Errno.Txtbsy, 75 => Errno.Xdev,
  _ => Errno.Notcapable,
};
