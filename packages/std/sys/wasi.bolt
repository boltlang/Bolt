#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_filestat_set_times(
  fd: Fd,
  flags: Lookupflags,
  path: [u8],
  atim: Timestamp,
  mtim: Timestamp,
  fst_flags: Fstflags,
) -> Errno;

/// Make a hard link.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_link(old_fd: Fd, old_flags: Lookupflags, old_path: [u8], new_fd: Fd, new_path: [u8]) -> Errno;

/// Open a file or directory: its new file descriptor.
#[link(wasm, module = "wasi_snapshot_preview1", abi = flat)]
pub(package) fn path_open(
  fd: Fd,
  dirflags: Lookupflags,
  path: [u8],
  oflags: Oflags,
  rights_base: Rights,
  rights_inheriting: Rights,
  fdflags: Fdflags,
