// The tests of `async.bolt`.

import "./async" *;
import "./io" (assert);
import "./ops" *;
import "./vec" (Vec, push, len, get);
import "./string" (String);

#[test]
fn block_on_runs_main() {
  let mut ran = False;
  block_on(|| { ran = True; });
  assert(ran);
}

#[test]
fn tasks_take_turns_at_pause() {
  let order: mut Vec[i32] = Vec.new();
  block_on(|| {
    fork(|| { order.push(2); pause(); order.push(4); });
    order.push(1);
    pause();
    order.push(3);
  });
  assert(order.len() == 4);
  assert(order[0] == 2 && order[1] == 1 && order[2] == 4 && order[3] == 3);
}

#[test]
fn wait_gives_what_the_task_gives() {
  let mut sum = 0;
  block_on(|| {
    let a = spawn(|| { pause(); 40 });
    let b = spawn(|| 2);
    sum = wait(a) + wait(b);
  });
  assert(sum == 42);
}

#[test]
fn waiting_for_a_task_that_is_done_does_not_stop() {
  let mut got = "";
  block_on(|| {
    let t = spawn(|| "done");
    pause();
    assert(is_done(t));
    got = wait(t);
  });
  assert(got == "done");
}

#[test]
fn several_tasks_can_wait_for_one() {
  let mut sum = 0;
  block_on(|| {
    let t = spawn(|| { pause(); pause(); 10 });
    let a = spawn(|| wait(t) + 1);
    let b = spawn(|| wait(t) + 2);
    sum = wait(a) + wait(b);
  });
  assert(sum == 23);
}

#[test]
fn a_waker_called_twice_wakes_once() {
  let mut runs = 0;
  block_on(|| {
    suspend(|wake| { wake(); wake(); });
    runs += 1;
  });
  assert(runs == 1);
}

fn count(n: i32) does Async {
  let mut i = 0;
  while i < n {
    pause();
    i += 1;
  }
}

#[test]
fn many_switches_do_not_grow_the_stack() {
  let mut done = False;
  block_on(|| {
    let t = spawn(|| count(20000));
    count(20000);
    wait(t);
    done = True;
  });
  assert(done);
}
