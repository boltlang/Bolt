        - WHITESPACE " "
        - PATH_TYPE
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "Int"
      - R_PAREN ")"
    - WHITESPACE " "
    - RET_TYPE
      - R_ARROW "->"
      - WHITESPACE " "
      - PATH_TYPE
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "Int"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - BIN_EXPR
      - PATH_EXPR
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "x"
      - WHITESPACE " "
      - PLUS "+"
      - WHITESPACE " "
      - LIT_EXPR
        - INT_NUMBER "1"
    - SEMI ";"
  - WHITESPACE "\n"
