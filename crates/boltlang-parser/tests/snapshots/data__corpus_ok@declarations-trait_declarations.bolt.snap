    - WHITESPACE " "
    - CLASS_KEYWORD "class"
    - WHITESPACE " "
    - NAME
      - IDENT "Item"
    - GENERIC_PARAM_LIST
      - L_BRACKET "["
      - TYPE_PARAM
        - NAME
          - IDENT "T"
      - R_BRACKET "]"
    - WHITESPACE " "
    - WHERE_CLAUSE
      - WHERE_KEYWORD "where"
      - WHITESPACE " "
      - WHERE_PRED
        - PATH_TYPE
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "T"
        - TRAIT_BOUNDS
          - COLON ":"
          - WHITESPACE " "
          - PATH_TYPE
            - PATH
              - PATH_SEGMENT
                - NAME_REF
                  - IDENT "Clone"
          - WHITESPACE " "
          - PLUS "+"
          - WHITESPACE " "
          - PATH_TYPE
            - PATH
              - PATH_SEGMENT
                - NAME_REF
                  - IDENT "Eq"
          - WHITESPACE " "
          - PLUS "+"
          - WHITESPACE " "
          - PATH_TYPE
            - PATH
              - PATH
                - PATH_SEGMENT
                  - NAME_REF
                    - IDENT "fmt"
              - DOT "."
              - PATH_SEGMENT
                - NAME_REF
                  - IDENT "Debug"
    - WHITESPACE " "
    - ITEM_LIST
      - L_BRACE "{"
      - WHITESPACE "\n    "
      - FUNC_DECL
        - FN_KEYWORD "fn"
        - WHITESPACE " "
        - NAME
          - IDENT "summarize"
        - PARAM_LIST
          - L_PAREN "("
          - SELF_PARAM
            - SELF_KEYWORD "self"
          - R_PAREN ")"
        - WHITESPACE " "
        - RET_TYPE
          - R_ARROW "->"
          - WHITESPACE " "
          - PATH_TYPE
            - PATH
              - PATH
                - PATH_SEGMENT
                  - NAME_REF
                    - IDENT "Self"
              - DOT "."
              - PATH_SEGMENT
                - NAME_REF
                  - IDENT "Summary"
        - SEMI ";"
      - WHITESPACE "\n"
      - R_BRACE "}"
  - WHITESPACE "\n"
