---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fn_return_type.bolt
---
- SOURCE_FILE
  - FUNC_DECL
    - FN_KEYWORD "fn"
    - WHITESPACE " "
    - NAME
      - IDENT "id"
    - PARAM_LIST
      - L_PAREN "("
      - PARAM
        - NAMED_PATT
          - NAME
            - IDENT "x"
      - R_PAREN ")"
    - WHITESPACE " "
    - RET_TYPE
      - R_ARROW "->"
      - WHITESPACE " "
      - PATH_TYPE
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "Int"
    - WHITESPACE " "
    - BLOCK_EXPR
      - BLOCK
        - L_BRACE "{"
        - WHITESPACE " "
        - PATH_EXPR
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "x"
        - WHITESPACE " "
        - R_BRACE "}"
  - WHITESPACE "\n"
