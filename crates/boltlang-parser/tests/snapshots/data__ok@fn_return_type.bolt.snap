---
- SOURCE_FILE
  - FUNC_DECL
    - FN_KEYWORD "fn"
    - WHITESPACE " "
    - IDENT "id"
    - L_PAREN "("
    - PARAM
      - NAMED_PATT
        - IDENT "x"
    - R_PAREN ")"
    - WHITESPACE " "
    - R_ARROW "->"
    - WHITESPACE " "
    - NAMED_TYPE_EXPR
      - IDENT "Int"
    - WHITESPACE " "
    - BLOCK_EXPR
      - BLOCK
        - L_BRACE "{"
        - WHITESPACE " "
        - PATH_EXPR
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "x"
        - WHITESPACE " "
        - R_BRACE "}"
  - WHITESPACE "\n"
