expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fun_expr_types.bolt
---
- SOURCE_FILE
  - LET_STMT
    - LET_KEYWORD "let"
    - WHITESPACE " "
    - NAMED_PATT
      - IDENT "inc"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - FUN_EXPR
      - FN_KEYWORD "fn"
      - WHITESPACE " "
      - L_PAREN "("
      - TYPED_PATT
        - NAMED_PATT
          - IDENT "x"
        - COLON ":"
        - WHITESPACE " "
        - NAMED_TYPE_EXPR
          - IDENT "Int"
      - R_PAREN ")"
      - WHITESPACE " "
      - R_ARROW "->"
      - WHITESPACE " "
      - NAMED_TYPE_EXPR
        - IDENT "Int"
      - WHITESPACE " "
      - EQUALS "="
      - WHITESPACE " "
      - BIN_EXPR
        - PATH_EXPR
          - IDENT "x"
        - WHITESPACE " "
        - PLUS "+"
        - WHITESPACE " "
        - LIT_EXPR
          - INT_NUMBER "1"
    - SEMI ";"
  - WHITESPACE "\n"
