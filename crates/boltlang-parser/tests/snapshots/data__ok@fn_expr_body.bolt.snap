expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fn_expr_body.bolt
---
- SOURCE_FILE
  - FUNC_DECL
    - FN_KEYWORD "fn"
    - WHITESPACE " "
    - IDENT "add"
    - PARAM_LIST
      - L_PAREN "("
      - PARAM
        - NAMED_PATT
          - IDENT "a"
      - COMMA ","
      - WHITESPACE " "
      - PARAM
        - NAMED_PATT
          - IDENT "b"
      - R_PAREN ")"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - BIN_EXPR
      - PATH_EXPR
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "a"
      - WHITESPACE " "
      - PLUS "+"
      - WHITESPACE " "
      - PATH_EXPR
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "b"
    - SEMI ";"
  - WHITESPACE "\n"
