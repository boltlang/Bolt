---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fn_operator.bolt
---
- SOURCE_FILE
  - FUNC_DECL
    - FN_KEYWORD "fn"
    - WHITESPACE " "
    - OPERATOR_NAME
      - L_PAREN "("
      - PLUS "+"
      - R_PAREN ")"
    - PARAM_LIST
      - L_PAREN "("
      - PARAM
        - NAMED_PATT
          - NAME
            - IDENT "a"
      - COMMA ","
      - WHITESPACE " "
      - PARAM
        - NAMED_PATT
          - NAME
            - IDENT "b"
      - R_PAREN ")"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - CALL_EXPR
      - PATH_EXPR
        - PATH
          - PATH_SEGMENT
            - NAME_REF
              - IDENT "add"
      - ARG_LIST
        - L_PAREN "("
        - PATH_EXPR
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "a"
        - COMMA ","
        - WHITESPACE " "
        - PATH_EXPR
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "b"
        - R_PAREN ")"
    - SEMI ";"
  - WHITESPACE "\n"
