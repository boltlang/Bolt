---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/corpus/ok/declarations-enums_with_values_specified.bolt
---
- SOURCE_FILE
  - ENUM
    - VISIBILITY
      - PUB_KEYWORD "pub"
    - WHITESPACE " "
    - ENUM_KEYWORD "enum"
    - WHITESPACE " "
    - NAME
      - IDENT "c_style_enum"
    - WHITESPACE " "
    - VARIANT_LIST
      - L_BRACE "{"
      - WHITESPACE "\n    "
      - VARIANT
        - NAME
          - IDENT "val1"
        - WHITESPACE " "
        - EQUALS "="
        - WHITESPACE " "
        - LIT_EXPR
          - INT_NUMBER "1"
      - COMMA ","
      - WHITESPACE "\n    "
      - VARIANT
        - NAME
          - IDENT "val2"
        - WHITESPACE " "
        - EQUALS "="
        - WHITESPACE " "
        - LIT_EXPR
          - INT_NUMBER "2"
      - WHITESPACE "\n"
      - R_BRACE "}"
  - WHITESPACE "\n"
