---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fn_block_body.bolt
---
- SOURCE_FILE
  - FUNC_DECL
    - FN_KEYWORD "fn"
    - WHITESPACE " "
    - IDENT "id"
    - L_PAREN "("
    - PARAM
      - NAMED_PATT
        - IDENT "x"
    - R_PAREN ")"
    - WHITESPACE " "
    - BLOCK
      - L_BRACE "{"
      - WHITESPACE " "
      - RET_EXPR
        - RETURN_KEYWORD "return"
        - WHITESPACE " "
        - PATH_EXPR
          - IDENT "x"
      - SEMI ";"
      - WHITESPACE " "
      - R_BRACE "}"
  - WHITESPACE "\n"
