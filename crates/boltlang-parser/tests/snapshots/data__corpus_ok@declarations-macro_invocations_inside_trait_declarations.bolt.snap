                - NAME_REF
                  - IDENT "B"
          - WHITESPACE " "
          - PLUS "+"
          - WHITESPACE " "
          - PATH_TYPE
            - PATH
              - PATH_SEGMENT
                - NAME_REF
                  - IDENT "C"
          - WHITESPACE " "
          - PLUS "+"
          - WHITESPACE " "
