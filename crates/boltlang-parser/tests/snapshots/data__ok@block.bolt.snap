---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/block.bolt
---
- SOURCE_FILE
  - EXPR_STMT
    - BLOCK_EXPR
      - BLOCK
        - L_BRACE "{"
        - WHITESPACE " "
        - LET_STMT
          - LET_KEYWORD "let"
          - WHITESPACE " "
          - NAMED_PATT
            - NAME
              - IDENT "x"
          - WHITESPACE " "
          - EQUALS "="
          - WHITESPACE " "
          - LIT_EXPR
            - INT_NUMBER "1"
          - SEMI ";"
        - WHITESPACE " "
        - PATH_EXPR
          - PATH
            - PATH_SEGMENT
              - NAME_REF
                - IDENT "x"
        - WHITESPACE " "
        - R_BRACE "}"
  - WHITESPACE "\n"
