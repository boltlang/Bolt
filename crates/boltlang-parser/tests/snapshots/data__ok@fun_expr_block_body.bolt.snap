---
- SOURCE_FILE
  - LET_STMT
    - LET_KEYWORD "let"
    - WHITESPACE " "
    - NAMED_PATT
      - NAME
        - IDENT "inc"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - FUN_EXPR
      - FN_KEYWORD "fn"
      - WHITESPACE " "
      - PARAM_LIST
        - L_PAREN "("
        - PARAM
          - NAMED_PATT
            - NAME
              - IDENT "x"
        - R_PAREN ")"
      - WHITESPACE " "
      - BLOCK_EXPR
