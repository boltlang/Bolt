          - L_BRACE "{"
          - WHITESPACE " "
          - BIN_EXPR
            - PATH_EXPR
              - PATH
                - PATH_SEGMENT
                  - NAME_REF
                    - IDENT "x"
            - WHITESPACE " "
            - PLUS "+"
            - WHITESPACE " "
            - LIT_EXPR
              - INT_NUMBER "1"
          - WHITESPACE " "
          - R_BRACE "}"
    - SEMI ";"
  - WHITESPACE "\n"
