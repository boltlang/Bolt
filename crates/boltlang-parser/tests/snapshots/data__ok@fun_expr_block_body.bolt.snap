---
source: crates/boltlang-parser/tests/data.rs
expression: "dump(&node, &diags)"
input_file: crates/boltlang-parser/tests/data/ok/fun_expr_block_body.bolt
---
- SOURCE_FILE
  - LET_STMT
    - LET_KEYWORD "let"
    - WHITESPACE " "
    - NAMED_PATT
      - IDENT "inc"
    - WHITESPACE " "
    - EQUALS "="
    - WHITESPACE " "
    - FUN_EXPR
      - FN_KEYWORD "fn"
      - WHITESPACE " "
      - L_PAREN "("
      - NAMED_PATT
        - IDENT "x"
      - R_PAREN ")"
      - WHITESPACE " "
      - BLOCK_EXPR
        - BLOCK
          - L_BRACE "{"
          - WHITESPACE " "
          - BIN_EXPR
            - PATH_EXPR
              - PATH
                - PATH_SEGMENT
                  - NAME_REF
                    - IDENT "x"
            - WHITESPACE " "
            - PLUS "+"
            - WHITESPACE " "
            - LIT_EXPR
              - INT_NUMBER "1"
          - WHITESPACE " "
          - R_BRACE "}"
    - SEMI ";"
  - WHITESPACE "\n"
