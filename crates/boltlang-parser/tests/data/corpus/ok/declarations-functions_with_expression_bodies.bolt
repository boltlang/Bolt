fn id(x) = x;
pub fn add(a, b: i32) -> i32 = a + b;
fn a + b = add(a, b);
fn pick[T](c, a: T, b: T) -> T = if c { a } else { b };
fn scale(x, by = 2) = x * by;
class Show[T] {
    fn show(self) -> String;
    fn print(self) = print(self.show());
}
impl Show[bool] {
    fn show(self) -> String = if self { "yes" } else { "no" };
}
