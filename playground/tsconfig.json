{
  // The library: src/ compiled to dist/ as ES modules, one per file, with
  // their types. It isn't bundled, so that the bundler of the app that uses
  // it finds the worker and the wasm files through `new URL(…,
  // import.meta.url)`, and so that it also works in a browser as it is.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
